---
import Profile from "./Profile.astro";
import Categories from "./Categories.astro";
import Tags from "./Tags.astro";

interface Props {
	class?: string;
}

const className = Astro.props.class;
---
<aside id="sidebar" class:list={[className, "w-full"]}>
    <!-- 个人名片卡：在常规文档流中，随页面自然滚动向上滑出 -->
    <div class="flex flex-col w-full gap-4 mb-4">
        <Profile class="onload-animation" style="animation-delay: 50ms"></Profile>
    </div>
    
    <!-- 分类与标签卡片：在个人名片向上滚动后，立即平滑吸附在屏幕顶部 top-4 保持固定不动 -->
    <div id="sidebar-sticky" class="transition-all duration-300 flex flex-col w-full gap-4 sticky top-4">
        <Categories class="onload-animation" style="animation-delay: 100ms"></Categories>
        <Tags class="onload-animation" style="animation-delay: 150ms"></Tags>
    </div>
</aside>
