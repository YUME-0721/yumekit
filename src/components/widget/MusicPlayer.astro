---
import MusicPlayerSvelte from "./MusicPlayer.svelte";
import { siteConfig } from "../../config";

interface Props {
	class?: string;
	style?: string;
}

const className = Astro.props.class;
const style = Astro.props.style;

const music = siteConfig.music;
if (!music || !music.enable) {
	return null;
}
---

<div class={className} style={style}>
    <MusicPlayerSvelte
        client:only="svelte"
        title={music.title || "音乐"}
        server={music.server || "netease"}
        type={music.type || "playlist"}
        id={String(music.id || "914046086")}
        autoPlay={music.autoPlay ?? false}
        defaultVolume={music.volume ?? 0.7}
    />
</div>
