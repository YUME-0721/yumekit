---
import { Icon } from "astro-icon/components";
---

<style>
    #notification-panel {
        position: relative;
        width: 3.75rem;
        height: 3.75rem;
        border-radius: 50%;
        overflow: hidden;
        box-sizing: border-box;
        transition:
            width 360ms cubic-bezier(0.4, 0, 0.2, 1),
            height 360ms cubic-bezier(0.4, 0, 0.2, 1),
            border-radius 360ms cubic-bezier(0.4, 0, 0.2, 1),
            transform 260ms cubic-bezier(0.34, 1.56, 0.64, 1),
            opacity 260ms ease;
    }
    #notification-panel.is-open {
        width: var(--np-open-width, min(20rem, calc(100vw - 2rem)));
        height: var(--np-open-height, min(70vh, 34rem));
        border-radius: 1rem;
    }
    #notification-minimized {
        position: absolute;
        inset: 0;
        transition: opacity 160ms ease, transform 260ms cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    #notification-content {
        position: absolute;
        inset: 0;
        opacity: 0;
        pointer-events: none;
        transform: translateY(8px);
        transition: opacity 200ms ease, transform 260ms ease;
    }
    #notification-panel.is-open #notification-minimized {
        opacity: 0;
        pointer-events: none;
        transform: none;
    }
    #notification-panel.is-open-content #notification-content {
        opacity: 1;
        pointer-events: auto;
        transform: translateY(0);
    }
</style>

<div id="new-post-notification" class="fixed bottom-4 right-4 z-50 pointer-events-none">
    <div id="notification-panel" class="pointer-events-auto bg-[var(--card-bg)] border-2 border-[var(--primary)] text-[var(--primary)] shadow-lg transform translate-y-20 opacity-0">
        <button id="notification-minimized" aria-label="New post notification" class="flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path></svg>
        </button>

        <div id="notification-content" class="flex flex-col p-5">
            <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2 text-[var(--primary)]">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle></svg>
                    <h3 class="font-bold text-black dark:text-white">发现新文章</h3>
                </div>
                <div class="flex items-center gap-1">
                    <button id="clear-notification" class="text-black/50 dark:text-white/50 hover:text-red-500 transition-colors p-1 rounded-md hover:bg-red-500/10" title="清空通知">
                        <Icon name="material-symbols:delete-rounded" size={18} class="mx-auto" />
                    </button>
                    <button id="minimize-notification" class="text-black/50 dark:text-white/50 hover:text-[var(--primary)] transition-colors p-1 rounded-md hover:bg-[var(--primary)]/10" title="隐藏">
                        <Icon name="material-symbols:close-rounded" size={18} class="mx-auto" />
                    </button>
                </div>
            </div>
            <div id="new-post-list" class="text-sm text-black/80 dark:text-white/80 transition-colors space-y-3 flex-1 overflow-y-auto overflow-x-hidden"></div>
        </div>
    </div>
    <span id="notification-dot" class="absolute top-0 right-0 w-3 h-3 bg-red-500 rounded-full border-2 border-[var(--card-bg)] animate-pulse pointer-events-none transform translate-y-20 opacity-0 scale-0 transition-all duration-260 ease-out"></span>
</div>

<script is:inline>
    // 使用 CDN 加载 diff 库
    if (!window.Diff) {
        var script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/diff@7.0.0/dist/diff.min.js';
        script.onload = initNotification;
        document.head.appendChild(script);
    } else {
        initNotification();
    }

    function initNotification() {
        (async function() {
            var __diffLogEnabled = (function() {
                try {
                    var sp = new URLSearchParams(window.location.search);
                    return sp.get('__diff_log') === '1';
                } catch {
                    return false;
                }
            })();
            var BASE_URL = import.meta.env.BASE_URL || '/';
            var basePath = String(BASE_URL).endsWith('/') ? String(BASE_URL).slice(0, -1) : String(BASE_URL);
            var withBasePath = function(pathname) {
                var p = String(pathname || '');
                if (!basePath || basePath === '/' || !p.startsWith('/')) return p;
                if (p === basePath || p.startsWith(basePath + '/')) return p;
                return basePath + p;
            };

            var sp = new URLSearchParams(window.location.search);
            if (sp.get('__diff_debug_cleanup') === '1') {
                try {
                    indexedDB.deleteDatabase('fuwari-rss-store');
                } catch {
                }
                try {
                    var url = new URL(window.location.href);
                    url.searchParams.delete('__diff_debug_cleanup');
                    history.replaceState({}, '', url.pathname + url.search + url.hash);
                } catch {
                }
                return;
            }
            if (sp.get('__diff_debug') === '1') return;
            var DB_NAME = 'fuwari-rss-store';
            var DB_VERSION = 4;
            var STORE_OLD = 'posts';
            var STORE_NEW = 'posts_new';
            var LOCAL_STORAGE_KEY = 'blog-posts-cache';
            var NOTIFICATION_ID = 'new-post-notification';
            var LIST_ID = 'new-post-list';
            
            // Compute a context-aware ID for the current site/path
            var BASE_PATH = import.meta.env.BASE_URL ?? '/';
            var SCOPE_ID = BASE_PATH.replace(/^\/+|\/+$/g, '') || 'root';

            // IndexedDB Helpers
            function openDB() {
                return new Promise(function(resolve, reject) {
                    var request = indexedDB.open(DB_NAME, DB_VERSION);
                    request.onerror = function() { reject(request.error); };
                    request.onsuccess = function() { resolve(request.result); };
                    request.onupgradeneeded = function(event) {
                        var db = event.target.result;
                        var ensureStore = function(name) {
                            if (db.objectStoreNames.contains(name)) {
                                var existingStore = event.target.transaction.objectStore(name);
                                if (existingStore.keyPath !== 'id') {
                                    db.deleteObjectStore(name);
                                    db.createObjectStore(name, { keyPath: 'id' });
                                }
                                return;
                            }
                            db.createObjectStore(name, { keyPath: 'id' });
                        };
                        ensureStore(STORE_OLD);
                        ensureStore(STORE_NEW);
                    };
                });
            }

            function normalizeGuid(guid, link) {
                var value = (guid || link || '').trim();
                if (!value) return '';
                try {
                    var url = new URL(value, window.location.origin);
                    return url.pathname + url.search + url.hash;
                } catch {
                    return value;
                }
            }

            function generateId(guid) {
                // Create a unique ID combining the scope (pathname root) and the article guid
                return SCOPE_ID + ':' + guid;
            }

            function getStoredPosts(db, storeName) {
                return new Promise(function(resolve, reject) {
                    var transaction = db.transaction([storeName], 'readonly');
                    var store = transaction.objectStore(storeName);
                    var request = store.getAll();
                    request.onsuccess = function() { resolve(request.result); };
                    request.onerror = function() { reject(request.error); };
                });
            }

            function clearStore(db, storeName) {
                return new Promise(function(resolve, reject) {
                    var transaction = db.transaction([storeName], 'readwrite');
                    var store = transaction.objectStore(storeName);
                    store.clear();
                    transaction.oncomplete = function() { resolve(); };
                    transaction.onerror = function() { reject(transaction.error); };
                });
            }

            function savePosts(db, storeName, posts) {
                return new Promise(function(resolve, reject) {
                    var transaction = db.transaction([storeName], 'readwrite');
                    var store = transaction.objectStore(storeName);
                    
                    posts.forEach(function(post) {
                        var itemToSave = Object.assign({}, post, { id: generateId(post.guid) });
                        store.put(itemToSave);
                    });
                    
                    transaction.oncomplete = function() { resolve(); };
                    transaction.onerror = function() { reject(transaction.error); };
                });
            }

            // Helper to get current RSS items
            async function fetchRSS() {
                try {
                    var response = await fetch('/rss.xml', { cache: 'no-store' });
                    var text = await response.text();
                    var parser = new DOMParser();
                    var xml = parser.parseFromString(text, 'text/xml');
                    
                    var channelLink = xml.querySelector("channel > link")?.textContent?.trim();
                    var prodOrigin = "";
                    if (channelLink) {
                        try {
                            prodOrigin = new URL(channelLink).origin;
                        } catch {}
                    }
                    var currentOrigin = window.location.origin;
                    
                    var items = Array.from(xml.querySelectorAll('item'));
                    
                    return items.map(function(item) {
                        var title = item.querySelector('title')?.textContent || '';
                        var link = (item.querySelector('link')?.textContent || '').trim();
                        var rawGuid = (item.querySelector('guid')?.textContent || '').trim();
                        var pubDate = new Date(item.querySelector('pubDate')?.textContent || '').getTime();
                        var description = item.querySelector('description')?.textContent || '';
                        
                        // Try to get content from multiple possible sources to ensure we capture it
                        var contentEncoded = item.getElementsByTagNameNS('http://purl.org/rss/1.0/modules/content/', 'encoded')[0]?.textContent;
                        var content = contentEncoded || 
                                        item.getElementsByTagName('content:encoded')[0]?.textContent || 
                                        item.querySelector('content')?.textContent || '';

                        // Replace production origin with current origin
                        if (prodOrigin && prodOrigin !== currentOrigin) {
                            link = link.replaceAll(prodOrigin, currentOrigin);
                            if (rawGuid.includes(prodOrigin)) {
                                rawGuid = rawGuid.replaceAll(prodOrigin, currentOrigin);
                            }
                            description = description.replaceAll(prodOrigin, currentOrigin);
                            content = content.replaceAll(prodOrigin, currentOrigin);
                        }

                        var guid = normalizeGuid(rawGuid || link, link);

                        return {
                            title: title,
                            link: link,
                            guid: guid,
                            pubDate: pubDate,
                            description: description,
                            content: content
                        };
                    });
                } catch (e) {
                    console.error('Failed to fetch RSS:', e);
                    return [];
                }
            }

            // Helper to compute raw diff (keep <content:encoded> HTML to preserve images)
            function computeDiff(oldText, newText) {
                if (!oldText || !newText) return null;

                var normalizeRaw = function(text) {
                    var s = String(text || "").replace(/\r\n/g, "\n").replace(/\r/g, "\n");
                    var lines = s.split("\n").map(function(line) { return line.replace(/[ \t]+$/g, ""); });
                    return lines.join("\n").trim();
                };

                var normalizeForDiffHtml = function(html) {
                    var raw = normalizeRaw(html);
                    if (!raw) return "";
                    var parser = new DOMParser();
                    var doc = parser.parseFromString('<div>' + raw + '</div>', "text/html");
                    var root = doc.body.firstElementChild;
                    if (!root) return raw;

                    var lines = [];
                    for (var i = 0; i < root.children.length; i++) {
                        var el = root.children[i];
                        var htmlLine = String(el.outerHTML || "")
                            .replace(/\r\n/g, "\n")
                            .replace(/\r/g, "\n")
                            .replace(/\n+/g, " ")
                            .replace(/[ \t]+/g, " ")
                            .trim();
                        if (!htmlLine) continue;
                        lines.push(htmlLine);
                    }

                    return lines.join("\n");
                };

                var cleanOld = normalizeForDiffHtml(oldText);
                var cleanNew = normalizeForDiffHtml(newText);

                if (!cleanOld || !cleanNew) return null;

                // Use 'diff' library to compute line-by-line diff
                var diffs = window.Diff.diffLines(cleanOld, cleanNew);
                
                var hasChanges = diffs.some(function(part) { return part.added || part.removed; });
                
                if (!hasChanges) return null;

                return diffs;
            }

            function escapeHtml(text) {
                if (!text) return text;
                return text
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }

            // Helper to show notification
            function showNotification(newPosts, timestamp, isFresh, initTime) {
                var minimizedBtn = document.getElementById('notification-minimized');
                var panel = document.getElementById('notification-panel');
                var list = document.getElementById(LIST_ID);
                var dot = document.getElementById('notification-dot');
                var minimizeBtn = document.getElementById('minimize-notification');
                var clearBtn = document.getElementById('clear-notification');
                var NOTIFICATION_STATE_KEY = 'fuwari-notification-state';
                var INIT_TIME_KEY = 'fuwari-notification-init-time';
                
                if (!minimizedBtn || !panel || !list) return;
                
                requestAnimationFrame(function() {
                    panel.classList.remove('translate-y-20', 'opacity-0');
                    if (dot) dot.classList.remove('translate-y-20', 'opacity-0');
                });

                var initTimeStr = new Date(initTime).toLocaleString();
                var checkTimeStr = new Date(timestamp).toLocaleString();

                // Logic for "No updates"
                if (newPosts.length === 0) {
                    list.innerHTML = '<div class="text-center text-gray-500 dark:text-gray-400 py-4">\n                <p class="text-sm font-medium mb-2">暂无文章更新</p>\n                <div class="text-xs opacity-70 bg-gray-100 dark:bg-gray-800 rounded px-2 py-1 inline-block">\n                    ' + initTimeStr + ' - ' + checkTimeStr + '\n                </div>\n             </div>';
                    if (dot) dot.classList.add('scale-0');
                    
                    // Setup event listeners even if no posts (so it can be opened)
                    setupEventListeners();
                    return;
                }
                
                // Show timestamp header
                var html = '\n            <div class="text-xs text-gray-500 dark:text-gray-400 mb-2 px-1 flex flex-col gap-0.5">\n                <div class="font-medium">发现更新</div>\n                <div class="opacity-70 text-[10px]">' + initTimeStr + ' - ' + checkTimeStr + '</div>\n            </div>';
                
                newPosts.forEach(function(post) {
                    var isUpdated = post.isUpdated;
                    var badge = isUpdated 
                        ? '<span class="text-xs bg-blue-100 dark:bg-blue-900 text-blue-600 dark:text-blue-300 px-1.5 py-0.5 rounded ml-2">更新</span>'
                        : '<span class="text-xs bg-green-100 dark:bg-green-900 text-green-600 dark:text-green-300 px-1.5 py-0.5 rounded ml-2">新文章</span>';
                    
                    // Convert absolute URL to relative path
                    var postLink = post.link;
                    try {
                        var url = new URL(post.link);
                        postLink = url.pathname;
                    } catch {
                        // Keep original if not a valid URL
                    }

                    var postHref = postLink;
                    if (isUpdated && post.diff) {
                        try {
                            var url = new URL(postLink, window.location.origin);
                            url.searchParams.set('diff', '1');
                            url.hash = 'post-diff';
                            postHref = url.pathname + url.search + url.hash;
                        } catch {
                            var base = postLink.split('#')[0];
                            postHref = base.includes('?') ? base + '&diff=1#post-diff' : base + '?diff=1#post-diff';
                        }
                    }
                    postHref = withBasePath(postHref);

                    html += '\n            <div class="mb-4 last:mb-0">\n                <div class="flex items-center justify-between p-3 rounded-lg hover:bg-[var(--primary)]/5 transition-colors">\n                    <a href="' + postHref + '" class="font-medium truncate pr-2 hover:text-[var(--primary)] transition-colors text-black dark:text-white block flex-1">\n                        ' + post.title + '\n                    </a>\n                    <div class="flex items-center shrink-0">\n                        ' + badge + '\n                    </div>\n                </div>\n            </div>';
                });

                list.innerHTML = html;
                
                // Show red dot if there are any posts with changes
                if (newPosts.length > 0) {
                    if (dot) dot.classList.remove('scale-0');
                    // Auto-open panel only on first detection (isFresh)
                    if (isFresh) {
                        setTimeout(function() {
                            openPanel();
                        }, 1500);
                    }
                } else {
                    if (dot) dot.classList.add('scale-0');
                }

                function updatePanelTargetSize() {
                    var rootFontSize = Number.parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
                    var maxPanelWidthPx = Math.min(20 * rootFontSize, window.innerWidth - 32);
                    var minPanelWidthPx = Math.min(16 * rootFontSize, window.innerWidth - 32);

                    var longestTitle = 0;
                    for (var i = 0; i < newPosts.length; i++) {
                        var post = newPosts[i];
                        if (!post?.title) continue;
                        longestTitle = Math.max(longestTitle, String(post.title).length);
                    }

                    var estimatedWidthRem = 14 + Math.min(longestTitle, 30) * 0.2;
                    var estimatedWidthPx = estimatedWidthRem * rootFontSize;
                    var openWidthPx = Math.max(minPanelWidthPx, Math.min(maxPanelWidthPx, estimatedWidthPx));
                    panel.style.setProperty('--np-open-width', Math.round(openWidthPx) + 'px');

                    var sizer = document.createElement('div');
                    sizer.style.position = 'fixed';
                    sizer.style.left = '-10000px';
                    sizer.style.top = '0';
                    sizer.style.width = Math.round(openWidthPx) + 'px';
                    sizer.style.maxHeight = 'none';
                    sizer.style.overflow = 'visible';
                    sizer.style.pointerEvents = 'none';
                    sizer.style.visibility = 'hidden';

                    var content = document.getElementById('notification-content');
                    if (!content) return;
                    var clone = content.cloneNode(true);
                    if (clone instanceof HTMLElement) {
                        clone.style.position = 'static';
                        clone.style.inset = 'auto';
                        clone.style.opacity = '1';
                        clone.style.pointerEvents = 'auto';
                        clone.style.transform = 'none';
                        var idElements = clone.querySelectorAll('[id]');
                        for (var j = 0; j < idElements.length; j++) {
                            idElements[j].removeAttribute('id');
                        }
                        var listEl = clone.querySelector('#new-post-list');
                        if (listEl instanceof HTMLElement) {
                            listEl.style.maxHeight = 'none';
                            listEl.style.overflow = 'visible';
                        }
                    }

                    sizer.appendChild(clone);
                    document.body.appendChild(sizer);
                    var measuredHeightPx = (clone instanceof HTMLElement ? clone.scrollHeight : sizer.scrollHeight) + 4;
                    sizer.remove();

                    var maxPanelHeightPx = Math.min(window.innerHeight * 0.7, 34 * rootFontSize);
                    var minPanelHeightPx = 10 * rootFontSize;
                    var openHeightPx = Math.max(minPanelHeightPx, Math.min(maxPanelHeightPx, measuredHeightPx));
                    panel.style.setProperty('--np-open-height', Math.round(openHeightPx) + 'px');
                }

                function openPanel() {
                    updatePanelTargetSize();
                    panel.classList.add('is-open');
                    var prevTimer = panel.getAttribute('data-open-timer');
                    if (prevTimer) {
                        clearTimeout(Number(prevTimer));
                    }
                    var timer = window.setTimeout(function() {
                        panel.classList.add('is-open-content');
                        panel.removeAttribute('data-open-timer');
                    }, 360);
                    panel.setAttribute('data-open-timer', String(timer));
                }

                function closePanel() {
                    var prevTimer = panel.getAttribute('data-open-timer');
                    if (prevTimer) {
                        clearTimeout(Number(prevTimer));
                        panel.removeAttribute('data-open-timer');
                    }
                    panel.classList.remove('is-open-content');
                    panel.classList.remove('is-open');
                }

                function setupEventListeners() {
                    minimizedBtn.onclick = function() {
                        if (!panel.classList.contains('is-open')) {
                            openPanel();
                        } else {
                            closePanel();
                        }
                    };
            
                    minimizeBtn.onclick = function(e) {
                        e.stopPropagation();
                        closePanel();
                    };

                    if (clearBtn) {
                        clearBtn.onclick = function(e) {
                            e.stopPropagation();
                            localStorage.removeItem(NOTIFICATION_STATE_KEY);
                            
                            var now = Date.now();
                            localStorage.setItem(INIT_TIME_KEY, now.toString());
                            
                            showNotification([], now, false, now);
                        };
                    }
            
                    if (!list.hasAttribute('data-listening')) {
                        list.setAttribute('data-listening', 'true');
                    }

                    if (!panel.hasAttribute('data-resize-listening')) {
                        window.addEventListener('resize', function() {
                            if (!panel.classList.contains('is-open')) return;
                            updatePanelTargetSize();
                        });
                        panel.setAttribute('data-resize-listening', 'true');
                    }
                }
                
                setupEventListeners();
            }

            // Main logic
            try {
                // Developer Mode Check
                var urlParams = new URLSearchParams(window.location.search);
                var isDevMode = urlParams.has('debug-notification');

                if (isDevMode) {
                    console.log('[Notification] Developer mode active');
                    var mockDiff = [
                        { value: "This is some unchanged text context.\n", added: undefined, removed: undefined },
                        { value: "This line was removed.\n", added: undefined, removed: true },
                        { value: "This line is new.\n", added: true, removed: undefined },
                        { value: "More unchanged text.\n", added: undefined, removed: undefined }
                    ];
                    
                    var mockPosts = [
                        { title: 'Test New Post 1', link: '#', guid: 'test-1', isUpdated: false },
                        { 
                            title: 'Test Updated Post', 
                            link: '#', 
                            guid: 'test-2', 
                            isUpdated: true,
                            diff: mockDiff
                        },
                    ];
                    showNotification(mockPosts, Date.now(), true, Date.now());
                    return; 
                }

                var currentPosts = await fetchRSS();
                if (currentPosts.length === 0) return;

                var db = await openDB();
                var storedPostsOld = await getStoredPosts(db, STORE_OLD);
                var storedPostsNew = await getStoredPosts(db, STORE_NEW);
                var storedPosts = storedPostsOld;
                if (storedPostsNew.length > 0) {
                    storedPosts = storedPostsNew;
                    await clearStore(db, STORE_OLD);
                    await savePosts(db, STORE_OLD, storedPostsNew);
                }
                var NOTIFICATION_STATE_KEY = 'fuwari-notification-state';
                var INIT_TIME_KEY = 'fuwari-notification-init-time';

                // Helper to get or set init time
                var initTimestamp = localStorage.getItem(INIT_TIME_KEY);
                if (!initTimestamp) {
                    initTimestamp = Date.now().toString();
                    localStorage.setItem(INIT_TIME_KEY, initTimestamp);
                }
                var initTime = parseInt(initTimestamp);

                // Migration from localStorage (Old cache)
                var localCache = localStorage.getItem(LOCAL_STORAGE_KEY);
                if (storedPostsOld.length === 0 && localCache) {
                    console.log('[Notification] Migrating from localStorage...');
                    // Just init DB and clear old cache
                    await clearStore(db, STORE_OLD);
                    await savePosts(db, STORE_OLD, currentPosts);
                    await clearStore(db, STORE_NEW);
                    localStorage.removeItem(LOCAL_STORAGE_KEY);
                    // Treat as first visit (no updates)
                    showNotification([], Date.now(), false, initTime); 
                    return;
                }

                if (storedPostsOld.length === 0) {
                    // First visit
                    await clearStore(db, STORE_OLD);
                    await savePosts(db, STORE_OLD, currentPosts);
                    await clearStore(db, STORE_NEW);
                    // Clear any stale notification state
                    localStorage.removeItem(NOTIFICATION_STATE_KEY);
                    showNotification([], Date.now(), false, initTime);
                } else {
                    await clearStore(db, STORE_NEW);
                    await savePosts(db, STORE_NEW, currentPosts);
                    // Compare
                    var storedMap = new Map();
                    for (var i = 0; i < storedPosts.length; i++) {
                        var p = storedPosts[i];
                        storedMap.set(p.id || generateId(p.guid || p.link || p.title), p);
                    }
                    
                    var detectedChanges = [];

                    for (var j = 0; j < currentPosts.length; j++) {
                        var post = currentPosts[j];
                        var stored = storedMap.get(generateId(post.guid));
                        if (!stored) {
                            // New post
                            detectedChanges.push(Object.assign({}, post, { isUpdated: false }));
                        } else {
                            // Check for ANY change (Title, Description, Content)
                            var titleChanged = post.title !== stored.title;
                            var descriptionChanged = post.description !== stored.description;
                            var contentChanged = post.content !== stored.content;
                            
                            if (titleChanged || descriptionChanged || contentChanged) {
                                var result = {};
                                var hasChanges = false;
                                
                                if (contentChanged) {
                                    var d = computeDiff(stored.content, post.content);
                                    if (d) {
                                        result.content = d;
                                        hasChanges = true;
                                    }
                                }
                                
                                if (descriptionChanged) {
                                    var d = window.Diff.diffLines(stored.description, post.description);
                                    if (d && d.some(function(p) { return p.added || p.removed; })) {
                                        result.description = d;
                                        hasChanges = true;
                                    }
                                }
                                
                                if (titleChanged) {
                                    var d = window.Diff.diffLines(stored.title, post.title);
                                    if (d && d.some(function(p) { return p.added || p.removed; })) {
                                        result.title = d;
                                        hasChanges = true;
                                    }
                                }
                                
                                if (hasChanges) {
                                    if (__diffLogEnabled) {
                                        console.groupCollapsed('[NewPostNotification] computed diff', post.title);
                                        console.log({
                                            link: post.link,
                                            guid: post.guid,
                                            titleChanged: titleChanged,
                                            descriptionChanged: descriptionChanged,
                                            contentChanged: contentChanged
                                        });
                                        console.log('diff.raw', result);
                                        console.groupEnd();
                                    }
                                    detectedChanges.push(Object.assign({}, post, { 
                                        isUpdated: true, 
                                        diff: result,
                                        diffType: 'composite'
                                    }));
                                }
                            }
                        }
                    }

                    if (detectedChanges.length > 0) {
                        // Intercept: If all posts in the feed are detected as new (likely due to ID change or cache issue), suppress notification
                        var isAllNew = detectedChanges.length === currentPosts.length && detectedChanges.every(function(p) { return !p.isUpdated; });
                        // Also intercept if ALL posts are detected as updated (likely a full rebuild/re-hash of content without meaningful changes)
                        var isAllUpdated = detectedChanges.length === currentPosts.length && detectedChanges.every(function(p) { return p.isUpdated; });

                        if (isAllNew || isAllUpdated) {
                            console.log('[Notification] Intercepted "all new/updated" posts scenario. Suppressing notification.');
                            await clearStore(db, STORE_OLD);
                            await savePosts(db, STORE_OLD, currentPosts);
                            await clearStore(db, STORE_NEW);
                            // Clear state
                            localStorage.removeItem(NOTIFICATION_STATE_KEY);
                            showNotification([], Date.now(), false, initTime);
                            return;
                        }

                        // CASE 1: New updates detected
                        var timestamp = Date.now();
                        // Persist notification state
                        var state = {
                            timestamp: timestamp,
                            items: detectedChanges
                        };
                        localStorage.setItem(NOTIFICATION_STATE_KEY, JSON.stringify(state));
                        
                        // Show with Red Dot + Auto Open
                        showNotification(detectedChanges, timestamp, true, initTime);
                    } else {
                        // CASE 2: No new updates
                        // Check if we have a persisted notification state
                        var persistedStateStr = localStorage.getItem(NOTIFICATION_STATE_KEY);
                        if (persistedStateStr) {
                            try {
                                var state = JSON.parse(persistedStateStr);
                                // Show persisted items, NO Red Dot, NO Auto Open
                                showNotification(state.items, state.timestamp, false, initTime);
                            } catch (e) {
                                console.error('Failed to parse notification state', e);
                                showNotification([], Date.now(), false, initTime);
                            }
                        } else {
                            // No updates and no history -> "No updates"
                            showNotification([], Date.now(), false, initTime);
                        }
                    }
                }
            } catch (e) {
                console.error('New post check failed:', e);
            }
        })();
    }
</script>