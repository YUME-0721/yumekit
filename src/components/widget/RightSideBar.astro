---
import type { MarkdownHeading } from "astro";
import Announcement from "./Announcement.astro";
import MusicPlayer from "./MusicPlayer.astro";
import TOC from "./TOC.astro";
import { siteConfig } from "../../config";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
}

const className = Astro.props.class;
const { headings = [] } = Astro.props;

const tocEnabled = siteConfig.toc.enable;
const maxDepth = siteConfig.toc.depth || 3;
const filteredHeadings = headings.filter((h) => h.depth <= maxDepth);

const hasTOC = tocEnabled && filteredHeadings.length > 0;
const hasAnnouncement = siteConfig.announcement?.enable ?? false;
const hasMusic = siteConfig.music?.enable ?? false;
---

<aside id="right-sidebar" class:list={[className, "w-full"]}>
    <div id="right-sidebar-sticky" class="transition-all duration-300 flex flex-col w-full gap-4 sticky top-4">
        <!-- 文章目录动态插槽（Swup 容器 #toc-container，文章页展示目录，非文章页为空） -->
        <div id="toc-container" class="transition-swup-fade w-full">
            {hasTOC && (
                <div id="toc-sidebar" class="card-base p-4 max-h-[calc(100vh-20rem)] overflow-y-auto hide-scrollbar mb-4 onload-animation">
                    <div class="text-sm font-medium text-black/60 dark:text-white/60 mb-2 flex items-center justify-between">
                        <span>目录</span>
                    </div>
                    <TOC headings={filteredHeadings}></TOC>
                </div>
            )}
        </div>

        <!-- 公告栏与音乐播放器（常驻右侧栏，滚动时自然保持在视野顶部，切页不断流） -->
        {hasAnnouncement && <Announcement class="onload-animation" style="animation-delay: 100ms" />}
        {hasMusic && <MusicPlayer class="onload-animation" style="animation-delay: 150ms" />}
    </div>
</aside>
