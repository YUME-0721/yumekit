---
import type { MarkdownHeading } from "astro";

interface TocItem extends MarkdownHeading {
	children: TocItem[];
}

interface Props {
	items: TocItem[];
	level?: number;
}

const { items, level = 0 } = Astro.props;
---

{
	items.length > 0 && (
		<ul class:list={[
			level === 0 ? "space-y-1" : "pl-3 space-y-0.5 my-1 border-l border-black/8 dark:border-white/12 ml-2.5"
		]}>
			{items.map((item, index) => {
				const hasChildren = item.children && item.children.length > 0;
				return (
					<li class="toc-item relative" data-toc-slug={item.slug}>
						<div class="flex items-center group/item w-full">
							<a
								href={`#${item.slug}`}
								class:list={[
									"flex items-center relative transition w-full min-w-0 hover:bg-[var(--toc-btn-hover)] active:bg-[var(--toc-btn-active)]",
									{
										"px-2 py-1 min-h-[1.9rem] rounded-xl gap-2 my-0.5": level === 0,
										"px-2 py-1 min-h-[1.7rem] rounded-lg gap-2 my-0.5": level === 1,
										"px-1.5 py-0.5 min-h-[1.55rem] rounded-md gap-1.5 my-0.5": level >= 2,
									}
								]}
							>
								<div class:list={["transition shrink-0 flex items-center justify-center font-bold",
									{
										"w-4.5 h-4.5 rounded-md text-[11px] bg-[var(--toc-badge-bg)] text-[var(--btn-content)] toc-badge": level === 0,
										"w-3 h-3": level === 1,
										"w-2.5 h-2.5": level >= 2,
									}
								]}>
									{level === 0 && index + 1}
									{level === 1 && <div class="toc-dot transition w-1.5 h-1.5 rounded-full bg-black/25 dark:bg-white/30 group-hover/item:scale-125"></div>}
									{level === 2 && <div class="toc-dot transition w-1.5 h-1.5 rounded-full bg-black/20 dark:bg-white/20 group-hover/item:bg-[var(--primary)]"></div>}
									{level > 2 && <div class="toc-dot transition w-1 h-1 rounded-full bg-black/15 dark:bg-white/15"></div>}
								</div>
								<div class:list={["transition truncate pr-0.5 leading-normal", {
									"text-[13px] font-semibold text-black/85 dark:text-white/85": level === 0,
									"text-[12px] font-normal text-black/75 dark:text-white/75": level === 1,
									"text-[11.5px] font-normal text-black/60 dark:text-white/60": level >= 2,
								}]}>{item.text}</div>
							</a>
							{hasChildren && (
								<button
									type="button"
									class:list={[
										"toc-toggle-btn mr-0.5 rounded-md text-black/40 dark:text-white/40 hover:text-black/80 dark:hover:text-white/80 hover:bg-black/5 dark:hover:bg-white/10 transition-all duration-200 shrink-0",
										{
											"p-1": level === 0,
											"p-0.5": level > 0,
										}
									]}
									aria-label="Toggle sub-menu"
								>
									<svg class:list={[
										"transition-transform duration-300 transform",
										level === 0 ? "w-3.5 h-3.5" : "w-3 h-3"
									]} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
										<path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
									</svg>
								</button>
							)}
						</div>

						{hasChildren && (
							<div class="toc-sublist-wrapper overflow-hidden">
								<div class="min-h-0 overflow-hidden">
									<Astro.self items={item.children} level={level + 1} />
								</div>
							</div>
						)}
					</li>
				);
			})}
		</ul>
	)
}
