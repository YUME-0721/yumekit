---
import type { MarkdownHeading } from "astro";

interface TocItem extends MarkdownHeading {
	children: TocItem[];
}

interface Props {
	items: TocItem[];
	level?: number;
}

const { items, level = 0 } = Astro.props;
---

{
	items.length > 0 && (
		<ul class:list={[
			level === 0 ? "space-y-1" : "pl-3 space-y-1 my-1 border-l border-black/10 dark:border-white/15 ml-2.5"
		]}>
			{items.map((item, index) => {
				const hasChildren = item.children && item.children.length > 0;
				return (
					<li class="toc-item relative" data-toc-slug={item.slug}>
						<div class="flex items-center group/item w-full">
							<a
								href={`#${item.slug}`}
								class="px-2 flex items-center gap-2 relative transition w-full min-h-9 rounded-xl hover:bg-[var(--toc-btn-hover)] active:bg-[var(--toc-btn-active)] py-1.5 min-w-0"
							>
								<div class:list={["transition w-5 h-5 shrink-0 rounded-lg text-xs flex items-center justify-center font-bold",
									{
										"bg-[var(--toc-badge-bg)] text-[var(--btn-content)]": level === 0,
									}
								]}>
									{level === 0 && index + 1}
									{level === 1 && <div class="transition w-2 h-2 rounded-[0.1875rem] bg-[var(--toc-badge-bg)]"></div>}
									{level === 2 && <div class="transition w-1.5 h-1.5 rounded-sm bg-black/5 dark:bg-white/10"></div>}
									{level > 2 && <div class="transition w-1 h-1 rounded-sm bg-black/5 dark:bg-white/10"></div>}
								</div>
								<div class:list={["transition text-sm truncate pr-1", {
									"text-50 font-medium": level === 0 || level === 1,
									"text-30": level >= 2,
								}]}>{item.text}</div>
							</a>
							{hasChildren && (
								<button
									type="button"
									class="toc-toggle-btn p-1.5 mr-0.5 rounded-lg text-black/40 dark:text-white/40 hover:text-black/80 dark:hover:text-white/80 hover:bg-black/5 dark:hover:bg-white/10 transition-all duration-200 shrink-0"
									aria-label="Toggle sub-menu"
								>
									<svg class="w-3.5 h-3.5 transition-transform duration-300 transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
										<path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
									</svg>
								</button>
							)}
						</div>

						{hasChildren && (
							<div class="toc-sublist-wrapper overflow-hidden">
								<div class="min-h-0 overflow-hidden">
									<Astro.self items={item.children} level={level + 1} />
								</div>
							</div>
						)}
					</li>
				);
			})}
		</ul>
	)
}
