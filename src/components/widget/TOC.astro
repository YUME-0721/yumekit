---
import type { MarkdownHeading } from "astro";
import { siteConfig } from "../../config";
import TOCList from "./TOCList.astro";

interface Props {
	class?: string;
	headings: MarkdownHeading[];
}

let { headings = [] } = Astro.props;

let minDepth = 10;
for (const heading of headings) {
	minDepth = Math.min(minDepth, heading.depth);
}

const className = Astro.props.class;

const isPostsRoute = Astro.url.pathname.startsWith("/posts/");

const removeTailingHash = (text: string) => {
	let lastIndexOfHash = text.lastIndexOf("#");
	if (lastIndexOfHash !== text.length - 1) {
		return text;
	}

	return text.substring(0, lastIndexOfHash);
};

interface TocItem extends MarkdownHeading {
	children: TocItem[];
}

function buildToc(headings: MarkdownHeading[]): TocItem[] {
	const toc: TocItem[] = [];
	const parentStack: TocItem[] = [];

	headings.forEach((h) => {
		const item: TocItem = { ...h, text: removeTailingHash(h.text), children: [] };
		
		while (parentStack.length > 0 && parentStack[parentStack.length - 1].depth >= item.depth) {
			parentStack.pop();
		}

		if (parentStack.length > 0) {
			parentStack[parentStack.length - 1].children.push(item);
		} else {
			toc.push(item);
		}
		parentStack.push(item);
	});

	return toc;
}

const toc = buildToc(headings);
---
{isPostsRoute &&
<table-of-contents class:list={[className, "group block relative z-0 bg-[var(--float-panel-bg-opaque)] rounded-xl p-2"]}>
    <TOCList items={toc} />
    <div id="active-indicator" class:list={[{'hidden': headings.length == 0}, "-z-10 absolute bg-[var(--toc-btn-hover)] left-2 right-2 rounded-xl transition-all " +
        "group-hover:bg-transparent border-2 border-[var(--toc-btn-hover)] group-hover:border-[var(--toc-btn-active)] border-dashed"]}></div>
</table-of-contents>}

<script>
class TableOfContents extends HTMLElement {
    tocEl: HTMLElement | null = null;
    visibleClass = "visible";
    observer: IntersectionObserver;
    anchorNavTarget: HTMLElement | null = null;
    headingIdxMap = new Map<string, number>();
    headings: HTMLElement[] = [];
    tocEntries: HTMLAnchorElement[] = [];
    active: boolean[] = [];
    activeIndicator: HTMLElement | null = null;
    ticking = false;

    constructor() {
        super();
        this.observer = new IntersectionObserver(
            this.markVisibleSection, { threshold: 0 }
        );
    };

    markVisibleSection = (entries: IntersectionObserverEntry[]) => {
        entries.forEach((entry) => {
            const id = entry.target.getAttribute("id");
            const idx = id ? this.headingIdxMap.get(id) : undefined;
            if (idx !== undefined) {
                this.active[idx] = entry.isIntersecting;
            }

            if (entry.isIntersecting && this.anchorNavTarget === entry.target) {
                this.anchorNavTarget = null;
            }
        });

        if (!this.active.includes(true)) {
            this.fallback();
        }
        this.update();
    };

    updateActiveIndicator = () => {
        const activeEntries = this.tocEntries.filter(entry => entry.classList.contains(this.visibleClass));
        if (activeEntries.length === 0) {
            this.activeIndicator?.setAttribute("style", "display: none;");
            return;
        }

        // 寻找在当前 DOM 布局中真正可视的代表性 entry (若子节点被折叠隐藏，则指示器挂载在显示的父级标题上)
        const visibleActiveEntries = activeEntries.map(entry => {
            let currentLink: HTMLAnchorElement = entry;
            let li = currentLink.closest(".toc-item");
            while (li) {
                const wrapper = li.querySelector<HTMLElement>(":scope > .toc-sublist-wrapper");
                if (wrapper && !wrapper.classList.contains("is-expanded")) {
                    const parentLink = li.querySelector<HTMLAnchorElement>(":scope > div > a");
                    if (parentLink) {
                        currentLink = parentLink;
                    }
                }
                const parentLi: HTMLElement | null = li.parentElement?.closest(".toc-item") || null;
                li = parentLi;
            }
            return currentLink;
        });

        if (visibleActiveEntries.length === 0) return;

        const topmost = visibleActiveEntries[0];
        const bottommost = visibleActiveEntries[visibleActiveEntries.length - 1];

        // 基于 getBoundingClientRect 精确计算相对于 table-of-contents 容器的绝对偏移，彻底杜绝任何父级 relative 引起的错位
        const containerRect = this.getBoundingClientRect();
        const topmostRect = topmost.getBoundingClientRect();
        const bottommostRect = bottommost.getBoundingClientRect();

        if (containerRect.height === 0 || topmostRect.height === 0) return;

        const top = topmostRect.top - containerRect.top;
        const height = bottommostRect.bottom - topmostRect.top;

        this.activeIndicator?.setAttribute(
            "style",
            `display: block; top: ${top}px; height: ${height}px;`
        );
    };

    toggleActiveHeading = () => {
        let i = this.active.length - 1;
        while (i >= 0 && !this.active[i]) {
            this.tocEntries[i].classList.remove(this.visibleClass);
            i--;
        }
        while (i >= 0 && this.active[i]) {
            this.tocEntries[i].classList.add(this.visibleClass);
            i--;
        }
        while (i >= 0) {
            this.tocEntries[i].classList.remove(this.visibleClass);
            i--;
        }

        this.updateActiveIndicator();
    };

    scrollToActiveHeading = () => {
        if (this.anchorNavTarget || !this.tocEl) return;
        const activeHeading =
            document.querySelectorAll<HTMLDivElement>(`#toc-sidebar .${this.visibleClass}, #toc .${this.visibleClass}`);
        if (!activeHeading.length) return;

        const topmost = activeHeading[0];
        const bottommost = activeHeading[activeHeading.length - 1];
        const tocHeight = this.tocEl.clientHeight;

        let top;
        if (bottommost.getBoundingClientRect().bottom -
            topmost.getBoundingClientRect().top < 0.9 * tocHeight)
            top = topmost.offsetTop - 32;
        else
            top = bottommost.offsetTop - tocHeight * 0.8;

        this.tocEl.scrollTo({
            top,
            left: 0,
            behavior: "smooth",
        });
    };

    update = () => {
        requestAnimationFrame(() => {
            this.toggleActiveHeading();
            this.scrollToActiveHeading();
            setTimeout(() => {
                this.updateActiveIndicator();
            }, 320);
        });
    };

    toggleItem = (li: HTMLElement) => {
        const wrapper = li.querySelector<HTMLElement>(":scope > .toc-sublist-wrapper");
        const btn = li.querySelector<HTMLElement>(":scope > div > .toc-toggle-btn");
        if (!wrapper) return;

        const isExpanded = wrapper.classList.contains("is-expanded");
        if (isExpanded) {
            wrapper.classList.remove("is-expanded");
            btn?.classList.remove("is-expanded");
        } else {
            wrapper.classList.add("is-expanded");
            btn?.classList.add("is-expanded");
        }

        this.updateActiveIndicator();
        setTimeout(() => {
            this.updateActiveIndicator();
        }, 320);
    };

    fallback = () => {
        if (!this.headings.length) return;

        let activeIdx = 0;
        for (let i = 0; i < this.headings.length; i++) {
            const top = this.headings[i].getBoundingClientRect().top;
            if (top <= 140) {
                activeIdx = i;
            } else {
                break;
            }
        }
        this.active.fill(false);
        this.active[activeIdx] = true;
    };

    updateActiveHeadingByScroll = () => {
        if (this.anchorNavTarget || this.headings.length === 0) return;

        let activeIdx = 0;
        for (let i = 0; i < this.headings.length; i++) {
            const rect = this.headings[i].getBoundingClientRect();
            if (rect.top <= 140) {
                activeIdx = i;
            } else {
                break;
            }
        }

        this.active.fill(false);
        this.active[activeIdx] = true;
        this.toggleActiveHeading();
    };

    onScroll = () => {
        if (!this.ticking) {
            requestAnimationFrame(() => {
                this.updateActiveHeadingByScroll();
                this.ticking = false;
            });
            this.ticking = true;
        }
    };

    handleTocClick = (event: MouseEvent) => {
        const target = event.target as HTMLElement | null;
        if (!target) return;

        // 点击右侧展开/收缩箭头按钮
        const toggleBtn = target.closest<HTMLButtonElement>(".toc-toggle-btn");
        if (toggleBtn) {
            event.preventDefault();
            event.stopPropagation();
            const li = toggleBtn.closest<HTMLElement>(".toc-item");
            if (li) {
                this.toggleItem(li);
            }
            return;
        }

        // 点击锚点标题链接
        const anchor = target.closest<HTMLAnchorElement>("a[href^='#']");
        if (anchor) {
            const id = decodeURIComponent(anchor.hash?.substring(1));
            const idx = this.headingIdxMap.get(id);
            if (idx !== undefined) {
                this.anchorNavTarget = this.headings[idx];
                this.active.fill(false);
                this.active[idx] = true;
                this.toggleActiveHeading();
            } else {
                this.anchorNavTarget = null;
            }
        }
    };

    connectedCallback() {
        requestAnimationFrame(() => {
            this.init();
        });
        window.addEventListener("scroll", this.onScroll, { passive: true });
    };

    init() {
        this.tocEl = document.getElementById("toc-sidebar") || document.getElementById("toc-inner-wrapper");

        if (!this.tocEl) return;

        this.tocEl.removeEventListener("click", this.handleTocClick as any);
        this.tocEl.addEventListener("click", this.handleTocClick as any);

        this.activeIndicator = document.getElementById("active-indicator");

        this.tocEntries = Array.from(
            document.querySelectorAll<HTMLAnchorElement>("#toc-sidebar a[href^='#'], #toc a[href^='#']")
        );

        if (this.tocEntries.length === 0) return;

        this.headings = [];
        this.headingIdxMap.clear();

        for (let i = 0; i < this.tocEntries.length; i++) {
            const id = decodeURIComponent(this.tocEntries[i].hash?.substring(1));
            const heading = document.getElementById(id);
            if (heading instanceof HTMLElement) {
                this.headings.push(heading);
                this.headingIdxMap.set(id, i);
            }
        }

        this.active = new Array(this.tocEntries.length).fill(false);

        // 直接监听所有 heading 标题元素本身
        this.headings.forEach((heading) => {
            this.observer.unobserve(heading);
            this.observer.observe(heading);
        });

        this.updateActiveHeadingByScroll();
        this.update();
    };

    disconnectedCallback() {
        this.headings.forEach((heading) =>
            this.observer.unobserve(heading)
        );
        this.observer.disconnect();
        window.removeEventListener("scroll", this.onScroll);
        if (this.tocEl) {
            this.tocEl.removeEventListener("click", this.handleTocClick as any);
        }
    };
}

if (!customElements.get("table-of-contents")) {
    customElements.define("table-of-contents", TableOfContents);
}
</script>
