---
import type { MarkdownHeading } from "astro";
import { siteConfig } from "../../config";
import TOCList from "./TOCList.astro";

interface Props {
	class?: string;
	headings: MarkdownHeading[];
}

let { headings = [] } = Astro.props;

let minDepth = 10;
for (const heading of headings) {
	minDepth = Math.min(minDepth, heading.depth);
}
if (minDepth === 10) minDepth = 1;

const configDepth = siteConfig.toc.depth || 3;
const allowedMaxDepth = minDepth + configDepth - 1;
headings = headings.filter(h => h.depth <= allowedMaxDepth);

const className = Astro.props.class;

const isPostsRoute = Astro.url.pathname.startsWith("/posts/");

const removeTailingHash = (text: string) => {
	let lastIndexOfHash = text.lastIndexOf("#");
	if (lastIndexOfHash !== text.length - 1) {
		return text;
	}

	return text.substring(0, lastIndexOfHash);
};

interface TocItem extends MarkdownHeading {
	children: TocItem[];
}

function buildToc(headings: MarkdownHeading[]): TocItem[] {
	const toc: TocItem[] = [];
	const parentStack: TocItem[] = [];

	headings.forEach((h) => {
		const item: TocItem = { ...h, text: removeTailingHash(h.text), children: [] };
		
		while (parentStack.length > 0 && parentStack[parentStack.length - 1].depth >= item.depth) {
			parentStack.pop();
		}

		if (parentStack.length > 0) {
			parentStack[parentStack.length - 1].children.push(item);
		} else {
			toc.push(item);
		}
		parentStack.push(item);
	});

	return toc;
}

const toc = buildToc(headings);
---
{isPostsRoute &&
<table-of-contents class:list={[className, "group block relative z-0 bg-[var(--float-panel-bg-opaque)] rounded-xl p-1"]}>
    <TOCList items={toc} />
</table-of-contents>}

<style is:global>
.toc-item a {
    transition: background-color 0.15s ease, color 0.15s ease;
}
.toc-item a.visible {
    color: var(--primary) !important;
    font-weight: 600 !important;
    background-color: color-mix(in srgb, var(--primary) 10%, transparent);
}
.toc-item a.visible .toc-badge {
    background-color: var(--primary) !important;
    color: #ffffff !important;
    box-shadow: 0 1px 4px color-mix(in srgb, var(--primary) 30%, transparent);
}
.toc-item a.visible .toc-dot {
    background-color: var(--primary) !important;
    transform: scale(1.3);
    box-shadow: 0 0 5px var(--primary);
}
</style>

<script>
class TableOfContents extends HTMLElement {
    tocEl: HTMLElement | null = null;
    visibleClass = "visible";
    observer: IntersectionObserver;
    anchorNavTarget: HTMLElement | null = null;
    headingIdxMap = new Map<string, number>();
    headings: HTMLElement[] = [];
    tocEntries: HTMLAnchorElement[] = [];
    active: boolean[] = [];
    ticking = false;

    isHoveringToc = false;

    constructor() {
        super();
        this.observer = new IntersectionObserver(
            this.markVisibleSection, { threshold: 0 }
        );
    };

    handleTocWheel = (e: WheelEvent) => {
        if (!this.tocEl) return;
        const maxScroll = this.tocEl.scrollHeight - this.tocEl.clientHeight;
        if (maxScroll > 0) {
            e.preventDefault();
            e.stopPropagation();
            this.tocEl.scrollTop += e.deltaY;
        }
    };

    handleTocMouseEnter = () => {
        this.isHoveringToc = true;
    };

    handleTocMouseLeave = () => {
        this.isHoveringToc = false;
    };

    markVisibleSection = (entries: IntersectionObserverEntry[]) => {
        if (this.anchorNavTarget) {
            for (const entry of entries) {
                if (entry.isIntersecting && this.anchorNavTarget === entry.target) {
                    this.anchorNavTarget = null;
                    break;
                }
            }
        }
        this.fallback();
        this.update();
    };

    toggleActiveHeading = () => {
        const activeIdx = this.active.indexOf(true);
        for (let i = 0; i < this.tocEntries.length; i++) {
            if (i === activeIdx) {
                this.tocEntries[i].classList.add(this.visibleClass);
            } else {
                this.tocEntries[i].classList.remove(this.visibleClass);
            }
        }
    };

    syncAccordionWithActive = () => {
        const activeIdx = this.active.indexOf(true);
        if (activeIdx < 0) return;
        const activeEntry = this.tocEntries[activeIdx];
        if (!activeEntry) return;

        // 收集当前活跃标题所在的所有祖先 toc-item 节点
        const activeChainLis = new Set<HTMLElement>();
        let currLi = activeEntry.closest<HTMLElement>(".toc-item");
        while (currLi) {
            activeChainLis.add(currLi);
            currLi = currLi.parentElement?.closest<HTMLElement>(".toc-item") || null;
        }

        // 遍历所有包含子分支的目录项
        const allLis = this.querySelectorAll<HTMLElement>(".toc-item");
        allLis.forEach((li) => {
            const wrapper = li.querySelector<HTMLElement>(":scope > .toc-sublist-wrapper");
            const btn = li.querySelector<HTMLElement>(":scope > div > .toc-toggle-btn");
            if (!wrapper) return;

            const isManualExpanded = li.dataset.manualExpanded === "true";
            const isManualCollapsed = li.dataset.manualCollapsed === "true";

            if (activeChainLis.has(li)) {
                // 当前正读到该分支：自动平滑展开
                if (!isManualCollapsed) {
                    wrapper.classList.add("is-expanded");
                    btn?.classList.add("is-expanded");
                }
            } else {
                // 其他非活跃分支：自动平滑收起（保留用户明确手动展开的项）
                if (!isManualExpanded) {
                    wrapper.classList.remove("is-expanded");
                    btn?.classList.remove("is-expanded");
                    delete li.dataset.manualCollapsed;
                }
            }
        });
    };

    scrollToActiveHeading = () => {
        if (this.anchorNavTarget || !this.tocEl || this.isHoveringToc) return;
        const activeEntry = this.tocEntries.find(entry => entry.classList.contains(this.visibleClass));
        if (!activeEntry) return;

        const containerRect = this.tocEl.getBoundingClientRect();
        const targetRect = activeEntry.getBoundingClientRect();

        if (containerRect.height === 0 || targetRect.height === 0) return;

        const currentScrollTop = this.tocEl.scrollTop;
        const targetTopRelative = targetRect.top - containerRect.top;
        const targetBottomRelative = targetRect.bottom - containerRect.top;
        const containerHeight = this.tocEl.clientHeight;

        // 如果高亮项超出舒适的可视区域，立即平滑居中滚动
        if (targetTopRelative < 40 || targetBottomRelative > containerHeight - 40) {
            const desiredScrollTop = currentScrollTop + targetTopRelative - (containerHeight / 2) + (targetRect.height / 2);
            this.tocEl.scrollTo({
                top: Math.max(0, desiredScrollTop),
                behavior: "smooth",
            });
        }
    };

    update = () => {
        requestAnimationFrame(() => {
            this.toggleActiveHeading();
            this.syncAccordionWithActive();
            this.scrollToActiveHeading();
        });
    };

    toggleItem = (li: HTMLElement) => {
        const wrapper = li.querySelector<HTMLElement>(":scope > .toc-sublist-wrapper");
        const btn = li.querySelector<HTMLElement>(":scope > div > .toc-toggle-btn");
        if (!wrapper) return;

        const isExpanded = wrapper.classList.contains("is-expanded");
        if (isExpanded) {
            wrapper.classList.remove("is-expanded");
            btn?.classList.remove("is-expanded");
            li.dataset.manualCollapsed = "true";
            delete li.dataset.manualExpanded;
        } else {
            wrapper.classList.add("is-expanded");
            btn?.classList.add("is-expanded");
            li.dataset.manualExpanded = "true";
            delete li.dataset.manualCollapsed;
        }

        setTimeout(() => {
            this.scrollToActiveHeading();
        }, 150);
    };

    fallback = () => {
        if (!this.headings.length) return;

        let activeIdx = 0;
        for (let i = 0; i < this.headings.length; i++) {
            const top = this.headings[i].getBoundingClientRect().top;
            if (top <= 160) {
                activeIdx = i;
            } else {
                break;
            }
        }
        this.active.fill(false);
        this.active[activeIdx] = true;
    };

    updateActiveHeadingByScroll = () => {
        if (this.anchorNavTarget || this.headings.length === 0) return;

        let activeIdx = 0;
        for (let i = 0; i < this.headings.length; i++) {
            const rect = this.headings[i].getBoundingClientRect();
            if (rect.top <= 160) {
                activeIdx = i;
            } else {
                break;
            }
        }

        const prevActive = this.active.indexOf(true);
        if (prevActive !== activeIdx) {
            this.active.fill(false);
            this.active[activeIdx] = true;
            this.toggleActiveHeading();
            this.syncAccordionWithActive();
            this.scrollToActiveHeading();
        }
    };

    onScroll = () => {
        if (!this.ticking) {
            requestAnimationFrame(() => {
                this.updateActiveHeadingByScroll();
                this.ticking = false;
            });
            this.ticking = true;
        }
    };

    smoothScrollToTarget = (targetEl: HTMLElement) => {
        const headerOffset = 80; // 顶部导航栏避让间距
        const elementPosition = targetEl.getBoundingClientRect().top;
        const offsetPosition = Math.max(0, elementPosition + window.scrollY - headerOffset);
        const startY = window.scrollY || window.pageYOffset;
        const diff = offsetPosition - startY;

        if (Math.abs(diff) < 2) {
            this.anchorNavTarget = null;
            return;
        }

        // 根据滚动距离动态计算滑动时长（380ms ~ 700ms），模拟手机长页惯性滑动质感
        const duration = Math.min(700, Math.max(380, Math.abs(diff) * 0.32));
        const startTime = performance.now();

        // 丝滑 EaseInOutCubic 阻尼缓动曲线：起步平顺、中间疾驰、结尾优雅减速
        const easeInOutCubic = (t: number) =>
            t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;

        const animateScroll = (currentTime: number) => {
            const elapsed = currentTime - startTime;
            const progress = Math.min(elapsed / duration, 1);
            const easeProgress = easeInOutCubic(progress);

            window.scrollTo(0, startY + diff * easeProgress);

            if (progress < 1) {
                requestAnimationFrame(animateScroll);
            } else {
                this.anchorNavTarget = null;
            }
        };

        requestAnimationFrame(animateScroll);
    };

    handleTocClick = (event: MouseEvent) => {
        const target = event.target as HTMLElement | null;
        if (!target) return;

        // 点击右侧展开/收缩箭头按钮
        const toggleBtn = target.closest<HTMLButtonElement>(".toc-toggle-btn");
        if (toggleBtn) {
            event.preventDefault();
            event.stopPropagation();
            const li = toggleBtn.closest<HTMLElement>(".toc-item");
            if (li) {
                this.toggleItem(li);
            }
            return;
        }

        // 点击锚点标题链接：阻止原生瞬间闪跳，开启手机般长条平滑滑动
        const anchor = target.closest<HTMLAnchorElement>("a[href^='#']");
        if (anchor) {
            event.preventDefault();
            event.stopPropagation();

            const id = decodeURIComponent(anchor.hash?.substring(1));
            const idx = this.headingIdxMap.get(id);
            if (idx !== undefined && this.headings[idx]) {
                const targetHeading = this.headings[idx];
                this.anchorNavTarget = targetHeading;

                if (window.location.hash !== anchor.hash) {
                    history.pushState(null, "", anchor.hash);
                }

                this.active.fill(false);
                this.active[idx] = true;
                this.toggleActiveHeading();
                this.syncAccordionWithActive();
                this.scrollToActiveHeading();

                this.smoothScrollToTarget(targetHeading);
            }
        }
    };

    connectedCallback() {
        requestAnimationFrame(() => {
            this.init();
        });
        window.addEventListener("scroll", this.onScroll, { passive: true });
    };

    init() {
        this.tocEl = document.getElementById("toc-sidebar-scroll") || document.getElementById("toc-sidebar") || document.getElementById("toc-inner-wrapper");

        if (!this.tocEl) return;

        this.tocEl.removeEventListener("wheel", this.handleTocWheel as any);
        this.tocEl.addEventListener("wheel", this.handleTocWheel as any, { passive: false });
        this.tocEl.removeEventListener("mouseenter", this.handleTocMouseEnter);
        this.tocEl.addEventListener("mouseenter", this.handleTocMouseEnter);
        this.tocEl.removeEventListener("mouseleave", this.handleTocMouseLeave);
        this.tocEl.addEventListener("mouseleave", this.handleTocMouseLeave);

        this.tocEl.removeEventListener("click", this.handleTocClick as any);
        this.tocEl.addEventListener("click", this.handleTocClick as any);

        this.tocEntries = Array.from(
            document.querySelectorAll<HTMLAnchorElement>("#toc-sidebar a[href^='#'], #toc a[href^='#']")
        );

        if (this.tocEntries.length === 0) return;

        this.headings = [];
        this.headingIdxMap.clear();

        for (let i = 0; i < this.tocEntries.length; i++) {
            const id = decodeURIComponent(this.tocEntries[i].hash?.substring(1));
            const heading = document.getElementById(id);
            if (heading instanceof HTMLElement) {
                this.headings.push(heading);
                this.headingIdxMap.set(id, i);
            }
        }

        this.active = new Array(this.tocEntries.length).fill(false);

        // 直接监听所有 heading 标题元素本身
        this.headings.forEach((heading) => {
            this.observer.unobserve(heading);
            this.observer.observe(heading);
        });

        this.updateActiveHeadingByScroll();
        this.update();
    };

    disconnectedCallback() {
        this.headings.forEach((heading) =>
            this.observer.unobserve(heading)
        );
        this.observer.disconnect();
        window.removeEventListener("scroll", this.onScroll);
        if (this.tocEl) {
            this.tocEl.removeEventListener("wheel", this.handleTocWheel as any);
            this.tocEl.removeEventListener("mouseenter", this.handleTocMouseEnter);
            this.tocEl.removeEventListener("mouseleave", this.handleTocMouseLeave);
            this.tocEl.removeEventListener("click", this.handleTocClick as any);
        }
    };
}

if (!customElements.get("table-of-contents")) {
    customElements.define("table-of-contents", TableOfContents);
}
</script>
