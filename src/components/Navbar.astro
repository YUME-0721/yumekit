---
import { Icon } from "astro-icon/components";
import { navBarConfig } from "../config";
import { LinkPresets } from "../constants/link-presets";
import { LinkPreset, type NavBarLink } from "../types/config";
import { url } from "../utils/url-utils";

import Search from "./Search.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";
interface Props {
	class?: string;
	isHeroHome?: boolean;
}

const { class: className, isHeroHome = false } = Astro.props;

// 处理导航链接，将 LinkPreset 转换为 NavBarLink
function processLink(item: NavBarLink | LinkPreset): NavBarLink {
	if (typeof item === "number") {
		return LinkPresets[item];
	}
	return item;
}

// 处理顶级链接
let links: NavBarLink[] = navBarConfig.links.map(processLink);

// 处理子链接
links = links.map((link) => {
	if (link.children) {
		return {
			...link,
			children: link.children.map(processLink) as NavBarLink[],
		};
	}
	return link;
});

const currentPath = Astro.url.pathname;
function isCurrentLink(targetUrl: string): boolean {
	const p1 = targetUrl.replace(/^\/|\/$/g, "");
	const p2 = currentPath.replace(/^\/|\/$/g, "");
	return p1 === p2;
}
---
<div id="navbar" class="z-50 onload-animation">
    <div class:list={[
        className,
        "card-base border border-black/10 dark:border-white/15 !overflow-visible flex items-center transition-all duration-300",
        "w-fit max-w-[95vw] h-12 md:h-14 !rounded-full px-3 py-1.5 gap-1 justify-center bg-white/80 dark:bg-black/75 backdrop-blur-xl mt-3 shadow-xl ml-auto mr-3 md:mx-auto"
    ]}>
        <div class="hidden md:flex items-center space-x-1">
            {links.map((l) => {
                const hasChildren = l.children && l.children.length > 0;
                
                if (hasChildren) {
                    return (
                        <div class="dropdown-container relative" data-dropdown>
                            <button 
                                class:list={[
                                    "btn-plain scale-animation font-bold active:scale-95 transition-all flex items-center h-10 px-3.5 rounded-full text-sm"
                                ]}
                                aria-expanded="false"
                                aria-haspopup="true"
                            >
                                {l.icon && <Icon name={l.icon} class="text-[1rem] mr-1.5 opacity-80" />}
                                {l.name}
                                <Icon name="material-symbols:keyboard-arrow-down-rounded" class="text-[1.25rem] transition-transform duration-200 dropdown-arrow ml-1" />
                            </button>
                            <div class="dropdown-menu absolute top-full left-0 pt-2 opacity-0 invisible pointer-events-none transition-all duration-200 ease-out transform translate-y-[-8px] z-50">
                                <div class="dropdown-content bg-[var(--card-bg)] rounded-2xl shadow-xl border border-black/5 dark:border-white/10 py-1.5 min-w-[7.5rem] w-max">
                                    {l.children?.map((child: any) => (
                                        <a 
                                            href={child.external ? child.url : url(child.url)} 
                                            target={child.external ? "_blank" : null}
                                            class="dropdown-item flex items-center justify-between gap-3 px-3 py-2 text-black/75 dark:text-white/75 hover:text-[var(--primary)] hover:bg-[var(--btn-plain-bg-hover)] transition-colors duration-150 font-medium whitespace-nowrap"
                                        >
                                            <div class="flex items-center gap-1.5">
                                                {child.icon && <Icon name={child.icon} class="text-[0.95rem] opacity-80" />}
                                                <span class="text-xs font-bold">{child.name}</span>
                                            </div>
                                            {child.external && (
                                                <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.65rem] text-black/30 dark:text-white/30 shrink-0" />
                                            )}
                                        </a>
                                    ))}
                                </div>
                            </div>
                        </div>
                    );
                } else {
                    return (
                        <a aria-label={l.name} href={l.external ? l.url : url(l.url)} target={l.external ? "_blank" : null}
                           class:list={[
                               "btn-plain scale-animation font-bold active:scale-95 transition-all h-10 px-3.5 rounded-full text-sm"
                           ]}
                        >
                            <div class="flex items-center">
                                {l.icon && <Icon name={l.icon} class="text-[1rem] mr-1.5 opacity-80" />}
                                <span>{l.name}</span>
                                {l.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.875rem] transition -translate-y-[1px] ml-1 text-black/[0.2] dark:text-white/[0.2]"></Icon>}
                            </div>
                        </a>
                    );
                }
            })}
        </div>
        <div class="flex items-center gap-1">
            <Search isHeroHome={true} client:only="svelte"></Search>

            <button aria-label="Menu" name="Nav Menu" class="btn-plain scale-animation active:scale-90 md:!hidden flex items-center justify-center h-10 w-10 rounded-full" id="nav-menu-switch">
                <Icon name="material-symbols:menu-rounded" class="text-[1.25rem]"></Icon>
            </button>
        </div>
        <NavMenuPanel links={links}></NavMenuPanel>
    </div>
</div>

<style>
    .dropdown-container:hover .dropdown-menu,
    .dropdown-container:focus-within .dropdown-menu {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translateY(0);
    }

    .dropdown-container:hover .dropdown-arrow,
    .dropdown-container:focus-within .dropdown-arrow {
        transform: rotate(180deg);
    }

    .dropdown-item:first-child {
        border-radius: calc(var(--radius-large) - 0.5rem) calc(var(--radius-large) - 0.5rem) 0 0;
    }

    .dropdown-item:last-child {
        border-radius: 0 0 calc(var(--radius-large) - 0.5rem) calc(var(--radius-large) - 0.5rem);
    }
</style>

<script>
function loadButtonScript() {
    let menuBtn = document.getElementById("nav-menu-switch");
    if (menuBtn) {
        menuBtn.onclick = function () {
            let menuPanel = document.getElementById("nav-menu-panel");
            if (menuPanel) {
                menuPanel.classList.toggle("float-panel-closed");
            }
        };
    }
}

// 全局委托：点击下拉项后立即释放焦点，避免在新标签页打开后返回页面时菜单残留展开
document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const item = target?.closest(".dropdown-item");
    if (item) {
        (item as HTMLElement).blur();
        const container = item.closest(".dropdown-container");
        if (container) {
            (container as HTMLElement).blur();
            container.querySelector("button")?.blur();
        }
    }
});

// 当用户从外部新标签页切换回博客时，自动失焦关闭下拉菜单
window.addEventListener("focus", () => {
    if (document.activeElement && document.activeElement.closest(".dropdown-container")) {
        (document.activeElement as HTMLElement)?.blur();
    }
});

loadButtonScript();
</script>

