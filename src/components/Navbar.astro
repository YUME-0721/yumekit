---
import { Icon } from "astro-icon/components";
import { navBarConfig, siteConfig } from "../config";
import { LinkPresets } from "../constants/link-presets";
import { LinkPreset, type NavBarLink } from "../types/config";
import { url } from "../utils/url-utils";

import Search from "./Search.svelte";
import DisplaySettings from "./widget/DisplaySettings.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";
interface Props {
	class?: string;
	isHeroHome?: boolean;
}

const { class: className, isHeroHome = false } = Astro.props;

// 处理导航链接，将 LinkPreset 转换为 NavBarLink
function processLink(item: NavBarLink | LinkPreset): NavBarLink {
	if (typeof item === "number") {
		return LinkPresets[item];
	}
	return item;
}

// 处理顶级链接
let links: NavBarLink[] = navBarConfig.links.map(processLink);

// 处理子链接
links = links.map((link) => {
	if (link.children) {
		return {
			...link,
			children: link.children.map(processLink),
		};
	}
	return link;
});

const currentPath = Astro.url.pathname;
function isCurrentLink(targetUrl: string): boolean {
	const p1 = targetUrl.replace(/^\/|\/$/g, "");
	const p2 = currentPath.replace(/^\/|\/$/g, "");
	return p1 === p2;
}
---
<div id="navbar" class="z-50 onload-animation">
    {!isHeroHome && <div class="absolute h-8 left-0 right-0 -top-8 bg-[var(--card-bg)] transition"></div>}
    <div class:list={[
        className,
        "card-base border border-black/10 dark:border-white/15 !overflow-visible flex items-center transition-all duration-300",
        isHeroHome 
            ? "w-fit max-w-[95vw] h-12 md:h-14 rounded-full px-2.5 py-1.5 gap-1 justify-center bg-white/80 dark:bg-black/75 backdrop-blur-xl mt-3 shadow-xl ml-auto mr-3 md:mx-auto"
            : "max-w-[var(--page-width)] h-[4.5rem] !rounded-t-none justify-between px-4 mx-auto"
    ]}>
        {!isHeroHome && (
            <a href={url('/')} class="btn-plain scale-animation rounded-lg h-[3.25rem] px-5 font-bold active:scale-95">
                <div class="flex flex-row text-[var(--primary)] items-center text-[1.2rem] tracking-wider">
                    YUME
                </div>
            </a>
        )}

        <div class="hidden md:flex items-center space-x-1">
            {links.map((l) => {
                const hasChildren = l.children && l.children.length > 0;
                const isLinkActive = !hasChildren && isCurrentLink(l.url);
                
                if (hasChildren) {
                    return (
                        <div class="dropdown-container relative" data-dropdown>
                            <button 
                                class:list={[
                                    "btn-plain scale-animation font-bold active:scale-95 dropdown-trigger flex items-center transition-all",
                                    isHeroHome 
                                        ? "h-10 px-3.5 rounded-full text-sm"
                                        : "h-11 px-5 rounded-lg"
                                ]}
                                aria-expanded="false"
                                aria-haspopup="true"
                            >
                                {l.icon && <Icon name={l.icon} class:list={[isHeroHome ? "text-[1rem] mr-1.5" : "text-[1.1rem] mr-2"]} />}
                                {l.name}
                                <Icon name="material-symbols:keyboard-arrow-down-rounded" class="text-[1.25rem] transition-transform duration-200 dropdown-arrow ml-1" />
                            </button>
                            <div class="dropdown-menu absolute top-full left-0 pt-2 opacity-0 invisible pointer-events-none transition-all duration-200 ease-out transform translate-y-[-8px] z-50">
                                <div class="dropdown-content bg-[var(--card-bg)] rounded-[var(--radius-large)] shadow-xl border border-black/5 dark:border-white/10 py-2 min-w-[10rem]">
                                    {l.children?.map((child) => (
                                        <a 
                                            href={child.external ? child.url : url(child.url)} 
                                            target={child.external ? "_blank" : null}
                                            class="dropdown-item flex items-center justify-between px-4 py-2.5 text-black/75 dark:text-white/75 hover:text-[var(--primary)] hover:bg-[var(--btn-plain-bg-hover)] transition-colors duration-150 font-medium"
                                        >
                                            <div class="flex items-center">
                                                {child.icon && <Icon name={child.icon} class="text-[1rem] mr-2" />}
                                                <span>{child.name}</span>
                                            </div>
                                            {child.external && (
                                                <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.75rem] text-black/25 dark:text-white/25" />
                                            )}
                                        </a>
                                    ))}
                                </div>
                            </div>
                        </div>
                    );
                } else {
                    return (
                        <a aria-label={l.name} href={l.external ? l.url : url(l.url)} target={l.external ? "_blank" : null}
                           class:list={[
                               "btn-plain scale-animation font-bold active:scale-95 transition-all",
                               isHeroHome 
                                   ? "h-10 px-3.5 rounded-full text-sm"
                                   : "h-11 px-5 rounded-lg"
                           ]}
                        >
                            <div class="flex items-center">
                                {l.icon && <Icon name={l.icon} class:list={[isHeroHome ? "text-[1rem] mr-1.5 opacity-80" : "text-[1.1rem] mr-2"]} />}
                                <span>{l.name}</span>
                                {l.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.875rem] transition -translate-y-[1px] ml-1 text-black/[0.2] dark:text-white/[0.2]"></Icon>}
                            </div>
                        </a>
                    );
                }
            })}
        </div>
        <div class="flex items-center gap-1">
            <!--<SearchPanel client:load>-->
            <Search isHeroHome={isHeroHome} client:only="svelte"></Search>
            {!siteConfig.themeColor.fixed && (
                    <button aria-label="Display Settings" class:list={["btn-plain scale-animation active:scale-90 flex items-center justify-center", isHeroHome ? "h-10 w-10 rounded-full" : "h-11 w-11 rounded-lg"]} id="display-settings-switch">
                        <Icon name="material-symbols:palette-outline" class="text-[1.25rem]"></Icon>
                    </button>
            )}

            <button aria-label="Menu" name="Nav Menu" class:list={["btn-plain scale-animation active:scale-90 md:!hidden flex items-center justify-center", isHeroHome ? "h-10 w-10 rounded-full" : "h-11 w-11 rounded-lg"]} id="nav-menu-switch">
                <Icon name="material-symbols:menu-rounded" class="text-[1.25rem]"></Icon>
            </button>
        </div>
        <NavMenuPanel links={links}></NavMenuPanel>
        <DisplaySettings client:only="svelte"></DisplaySettings>
    </div>
</div>

<style>
    .dropdown-container:hover .dropdown-menu,
    .dropdown-container:focus-within .dropdown-menu {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translateY(0);
    }

    .dropdown-container:hover .dropdown-arrow,
    .dropdown-container:focus-within .dropdown-arrow {
        transform: rotate(180deg);
    }

    .dropdown-item:first-child {
        border-radius: calc(var(--radius-large) - 0.5rem) calc(var(--radius-large) - 0.5rem) 0 0;
    }

    .dropdown-item:last-child {
        border-radius: 0 0 calc(var(--radius-large) - 0.5rem) calc(var(--radius-large) - 0.5rem);
    }
</style>

<script>
function loadButtonScript() {

    let settingBtn = document.getElementById("display-settings-switch");
    if (settingBtn) {
        settingBtn.onclick = function () {
            let settingPanel = document.getElementById("display-setting");
            if (settingPanel) {
                settingPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    let menuBtn = document.getElementById("nav-menu-switch");
    if (menuBtn) {
        menuBtn.onclick = function () {
            let menuPanel = document.getElementById("nav-menu-panel");
            if (menuPanel) {
                menuPanel.classList.toggle("float-panel-closed");
            }
        };
    }
}

loadButtonScript();
</script>

