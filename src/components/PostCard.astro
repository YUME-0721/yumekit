---
import path from "node:path";
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";

import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { getDir, getCategoryUrl, getTagUrl } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	image: string;
	description: string;
	draft: boolean;
	style: string;
}
const { entry, title, url, published, updated, image, description, style } =
	Astro.props;

const isPinned = entry.data.pinned === true;
const className = Astro.props.class;

const hasCover = image !== undefined && image !== null && image !== "";
const coverWidth = "28%";

const { remarkPluginFrontmatter } = await entry.render();

const category = entry.data.category ? entry.data.category.trim() : "";
const tags = (entry.data.tags || []).map((t: string) => t.trim()).filter(Boolean);
const formattedDate = formatDateToYYYYMMDD(published).replace(/-/g, "/");

const displayTags = tags.slice(0, 4);
const remainingTagsCount = tags.length - 4;
---
<div class:list={["card-base card-hover flex flex-col w-full relative", className]} style={style}>
    <div class:list={["pl-9 pr-4 pt-5 pb-5 relative flex flex-col justify-between min-h-[9.5rem]", {"w-[calc(100%_-_52px_-_12px)]": !hasCover, "w-[calc(100%_-_var(--coverWidth)_-_12px)]": hasCover}]}>
        <div>
            <!-- 文章标题 -->
            <a href={url}
               class="transition group w-full block font-bold mb-2 text-xl md:text-2xl text-black/90 dark:text-white/90 relative
            hover:text-[var(--primary)] dark:hover:text-[var(--primary)]
            active:text-[var(--title-active)] dark:active:text-[var(--title-active)]
            before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
            before:absolute before:top-1 md:before:top-1.5 before:-left-[1.125rem] before:block
            ">
                {title}
            </a>

            <!-- 分类/系列与发布日期 -->
            <div class="flex items-center flex-wrap gap-x-4 gap-y-1 text-xs md:text-sm font-medium mb-2.5 text-neutral-500 dark:text-neutral-400">
                {category && (
                    <a href={getCategoryUrl(category)} class="flex items-center gap-1.5 text-[var(--primary)] hover:underline font-bold transition">
                        <Icon name="material-symbols:folder-outline-rounded" class="text-base md:text-lg"></Icon>
                        <span>{category}</span>
                    </a>
                )}
                <div class="flex items-center gap-1 text-neutral-400 dark:text-neutral-500">
                    <Icon name="material-symbols:calendar-today-outline-rounded" class="text-sm md:text-base"></Icon>
                    <span>{formattedDate}</span>
                </div>
            </div>

            <!-- 文章简介 -->
            <div class="transition text-black/70 dark:text-white/70 text-sm md:text-base leading-relaxed mb-3 pr-2 line-clamp-2">
                { description || remarkPluginFrontmatter.excerpt }
            </div>
        </div>

        <!-- 底部标签区域 -->
        {tags.length > 0 && (
            <div class="flex flex-wrap items-center gap-1.5 mt-1 pt-1">
                {displayTags.map((tag: string) => (
                    <a href={getTagUrl(tag)} class="btn-regular h-6 md:h-7 px-2.5 rounded-lg text-xs font-medium text-neutral-600 dark:text-neutral-300 hover:text-[var(--primary)] dark:hover:text-[var(--primary)] transition flex items-center gap-0.5 active:scale-95">
                        <span class="text-neutral-400 dark:text-neutral-500 font-semibold">#</span>
                        <span>{tag}</span>
                    </a>
                ))}
                {remainingTagsCount > 0 && (
                    <span class="text-xs font-semibold px-2 py-0.5 rounded-md bg-neutral-100 dark:bg-neutral-800 text-neutral-400 dark:text-neutral-500">
                        +{remainingTagsCount}
                    </span>
                )}
            </div>
        )}
    </div>

    {hasCover && <a href={url} aria-label={title}
                    class:list={["group",
                        "max-h-none mx-0 mt-0",
                        "w-[var(--coverWidth)] absolute top-3 bottom-3 right-3 rounded-xl overflow-hidden active:scale-95"
                    ]} >
        <div class="absolute pointer-events-none z-10 w-full h-full group-hover:bg-black/30 group-active:bg-black/50 transition"></div>
        <!-- 封面图上的箭头 -->
        <div class="absolute pointer-events-none z-20 w-full h-full flex items-center justify-center ">
            <Icon name="material-symbols:chevron-right-rounded"
                  class="transition opacity-0 group-hover:opacity-100 scale-50 group-hover:scale-100 text-white text-5xl">
            </Icon>
        </div>
        <ImageWrapper src={image} basePath={path.join("content/posts/", getDir(entry.id))} alt="Cover Image of the Post"
                  class="w-full h-full">
        </ImageWrapper>
    </a>}

    {!hasCover &&
        <a href={url} aria-label={title} class="!flex btn-regular w-[3.25rem]
         absolute right-3 top-3 bottom-3 rounded-xl bg-[var(--enter-btn-bg)]
         hover:bg-[var(--enter-btn-bg-hover)] active:bg-[var(--enter-btn-bg-active)] active:scale-95
        ">
            <Icon name="material-symbols:chevron-right-rounded"
                  class="transition text-[var(--primary)] text-4xl mx-auto">
            </Icon>
        </a>
    }
</div>

<style define:vars={{coverWidth}}>
</style>