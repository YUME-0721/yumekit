// 智能提取番剧制作公司或核心类型标签
function extractStudioOrGenre(tagsList: string[]): string {
	// 归一化工具：去除所有标点、空格、特殊符号并转小写
	const clean = (s: string) => s.toLowerCase().replace(/['’`\s\-_·.・]/g, "");

	// 0. 特别优先强化匹配常见易受标点影响的工作室
	for (const tag of tagsList) {
		const cTag = clean(tag);
		if (cTag === "brainsbase" || cTag.includes("brainsbase") || cTag.includes("ブレインズベース")) {
			return "Brain's Base";
		}
		if (cTag === "comixwave" || cTag === "comixwavefilms" || cTag.includes("コミックスウェーブ")) {
			return "CoMix Wave";
		}
		if (cTag === "sevenarcs" || cTag.includes("セブンアークス")) {
			return "Seven Arcs";
		}
		if (cTag.includes("ロックンロール") || cTag.includes("rocknroll")) {
			return "Rock'n'Roll Mountain";
		}
		if (cTag.includes("ラパントラック") || cTag.includes("lapintrack")) {
			return "Lapin Track";
		}
	}

	// 1. 先尝试从词典中精准/归一化匹配制作公司标签
	for (const tag of tagsList) {
		if (STUDIO_DICT[tag]) {
			return STUDIO_DICT[tag];
		}
		const cTag = clean(tag);
		for (const [key, name] of Object.entries(STUDIO_DICT)) {
			if (cTag === clean(key)) {
				return name;
			}
		}
	}

	// 2. 正则智能探测未收录的各类制作工作室 (如 "Studio XX", "XX制作", "XX动画", "XX社")
	for (const tag of tagsList) {
		const isExcluded = /^[0-9]+年|^(日本|中国|欧美|漫改|轻改|原创|小说改|游戏改|日常|搞笑|恋爱|战斗|热血|治愈|奇幻|科幻|百合|催泪|校园|后宫|泡面番|肉番|剧场版|OVA|TV|WEB)$/i.test(tag);
		if (!isExcluded) {
			if (/^(Studio|Studio\s|动画制作|制作|Animation|Pictures|Works|Film|ブレインズ)/i.test(tag) ||
				/(Studio|Pictures|Works|Animation|Films|Production|制作|社|工房|动画|ベース)$/i.test(tag)) {
				return tag.length > 14 ? tag.slice(0, 14) + "…" : tag;
			}
		}
	}

	// 3. 若无制作公司标签，优先展示核心改编/类型属性（如 "漫改" / "轻改" / "原创"）
	const sourceTag = tagsList.find((t: string) => ["漫改", "轻改", "原创", "小说改", "游戏改", "漫画改", "乙女向", "百合", "科幻", "日常", "恋爱", "奇幻", "热血", "搞笑", "悬疑"].includes(t));
	if (sourceTag) {
		return sourceTag;
	}

	// 4. 展示第一个有意义的标签
	if (tagsList.length > 0) {
		const validTag = tagsList.find((t: string) => !/^[0-9]+年|[0-9]{4}/.test(t));
		if (validTag) return validTag;
	}

	return "TV动画";
}

// 获取 Bangumi 收藏列表（带 6 秒快速超时与重试保护，避免阻塞本地构建）
async function fetchBangumiCollection(
	userId: string,
	subjectType: number,
	type: number,
) {
	try {
		const controller = new AbortController();
		const timeoutId = setTimeout(() => controller.abort(), 6000);

		const response = await fetch(
			`${BANGUMI_API_BASE}/v0/users/${userId}/collections?subject_type=${subjectType}&type=${type}&limit=50&offset=0`,
			{
				headers: {
					"User-Agent": "Fuwari-Blog-Anime/2.0 (https://github.com/YUME-0721/yumekit)",
				},
				signal: controller.signal,
			}
		);
		clearTimeout(timeoutId);

		if (!response.ok) {
			return null;
		}
		const data = await response.json();
		return data;
	} catch (error) {
		console.warn(`[Anime] Bangumi API collection (type=${type}) timed out or unreachable, will fallback.`);
		return null;
	}
}

// 快速解析番剧数据（不再逐项发几十次 persons 请求，大幅提升编译速度）
function processBangumiData(data: any, status: string) {
	if (!data || !data.data || !Array.isArray(data.data)) return [];

	return data.data.map((item: any) => {
		const year = item.subject?.date || "Unknown";
		const rating = item.rate ? Number.parseFloat(item.rate.toFixed(1)) : (item.subject?.score || 0);
		const progress = item.ep_status || 0;
		const totalEpisodes = item.subject?.eps || progress || 12;

		// 从 tags 智能提取制作公司或有代表性的分类
		const tagsList = (item.subject?.tags || []).map((t: any) => t.name).filter(Boolean);
		const studio = extractStudioOrGenre(tagsList);

		const rawCover = item.subject?.images?.large || item.subject?.images?.common || item.subject?.images?.medium || "";

		return {
			title: item.subject?.name_cn || item.subject?.name || "Unknown Title",
			status: status,
			rating: rating,
			cover: getAcceleratedCover(rawCover),
			rawCover: rawCover,
			description: (
				item.subject?.short_summary ||
				item.subject?.name_cn ||
				item.subject?.name ||
				""
			).trim(),
			episodes: `${totalEpisodes} 集`,
			year: year,
			genre: tagsList.slice(0, 3).length > 0 ? tagsList.slice(0, 3) : ["动画", "日常"],
			studio: studio,
			link: item.subject?.id
				? `https://bgm.tv/subject/${item.subject.id}`
				: "#",
			progress: progress,
			totalEpisodes: totalEpisodes,
			startDate: item.subject?.date || "",
			endDate: item.subject?.date || "",
		};
	});
}

// 根据配置模式加载番剧列表
let animeList: any[] = [];
if (ANIME_MODE === "local") {
	animeList = localAnimeList;
} else {
	try {
		// 并行发起 5 种状态请求，极速聚合
		const [watchingData, plannedData, completedData, onHoldData, droppedData] = await Promise.all([
			fetchBangumiCollection(BANGUMI_USER_ID, 2, 3),
			fetchBangumiCollection(BANGUMI_USER_ID, 2, 1),
			fetchBangumiCollection(BANGUMI_USER_ID, 2, 2),
			fetchBangumiCollection(BANGUMI_USER_ID, 2, 4),
			fetchBangumiCollection(BANGUMI_USER_ID, 2, 5),
		]);

		const watchingList = processBangumiData(watchingData, "watching");
		const plannedList = processBangumiData(plannedData, "planned");
		const completedList = processBangumiData(completedData, "completed");
		const onHoldList = processBangumiData(onHoldData, "onhold");
		const droppedList = processBangumiData(droppedData, "dropped");

		animeList = [
			...watchingList,
			...plannedList,
			...completedList,
			...onHoldList,
			...droppedList,
		];

		// 若由于网络原因未获取到任何远程数据，自动优雅回退到本地静态数据
		if (animeList.length === 0) {
			console.info("[Anime] Fallback to local anime list data.");
			animeList = localAnimeList;
		}
	} catch (e) {
		console.warn("[Anime] Error initializing anime list, fallback to local:", e);
		animeList = localAnimeList;
	}
}

// 获取状态翻译与样式
function getStatusInfo(status: string) {
	switch (status) {
		case "watching":
			return {
				text: "在看",
				class: "bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20",
				icon: "▶",
			};
		case "completed":
			return {
				text: "看过",
				class: "bg-blue-500/15 text-blue-600 dark:text-blue-400 border border-blue-500/20",
				icon: "✓",
			};
		case "planned":
			return {
				text: "想看",
				class: "bg-amber-500/15 text-amber-600 dark:text-amber-400 border border-amber-500/20",
				icon: "⏰",
			};
		case "onhold":
			return {
				text: "搁置",
				class: "bg-purple-500/15 text-purple-600 dark:text-purple-400 border border-purple-500/20",
				icon: "⏸",
			};
		case "dropped":
			return {
				text: "抛弃",
				class: "bg-rose-500/15 text-rose-600 dark:text-rose-400 border border-rose-500/20",
				icon: "✗",
			};
		default:
			return {
				text: status,
				class: "bg-neutral-500/15 text-neutral-600 dark:text-neutral-400",
				icon: "•",
			};
	}
}
