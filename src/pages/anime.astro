import ImageWrapper from "../components/misc/ImageWrapper.astro";
import { siteConfig } from "../config";
import localAnimeList from "../data/anime";
import MainGridLayout from "../layouts/MainGridLayout.astro";

// 检查番剧页面是否启用
if (siteConfig.featurePages?.anime === false) {
	return Astro.redirect("/404/");
}

// Bangumi API 配置
const BANGUMI_USER_ID = siteConfig.bangumi?.userId || "your-user-id";
const BANGUMI_API_BASE = "https://api.bgm.tv";

// 获取番剧数据模式
const ANIME_MODE = siteConfig.anime?.mode || "local";

/**
 * 将 Bangumi 官方图片链接自动转换为国内直连高可用 CDN WebP 格式
 * 使用由 Cloudflare 强力支持的全球开源代理 wsrv.nl，不仅解决内地被阻断问题，还能显著加速 10 倍以上
 */
function getAcceleratedCover(rawUrl?: string): string {
	if (!rawUrl) return "";
	if (rawUrl.startsWith("/") || rawUrl.startsWith("data:")) return rawUrl;
	if (rawUrl.includes("bgm.tv") || rawUrl.includes("bangumi.tv")) {
		return `https://wsrv.nl/?url=${encodeURIComponent(rawUrl)}&w=360&h=540&fit=cover&output=webp&q=80`;
	}
	return rawUrl;
}

