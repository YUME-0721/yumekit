---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import PostCard from "../components/PostCard.astro";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getSortedPosts, getCategoryList, getTagList } from "../utils/content-utils";
import { getPostUrlBySlug, url } from "../utils/url-utils";
import { profileConfig, siteConfig, umamiConfig } from "../config";

const allPosts = await getSortedPosts();
const categories = await getCategoryList();
const tags = await getTagList();

const recentPosts = allPosts.slice(0, 4);

let delay = 0;
const interval = 50;

const skillsList = [
	{ name: "Docker", icon: "fa6-brands:docker" },
	{ name: "Linux", icon: "fa6-brands:linux" },
	{ name: "Astro", icon: "simple-icons:astro" },
	{ name: "Svelte", icon: "simple-icons:svelte" },
	{ name: "TypeScript", icon: "simple-icons:typescript" },
	{ name: "React", icon: "fa6-brands:react" },
	{ name: "Tailwind CSS", icon: "simple-icons:tailwindcss" },
	{ name: "Node.js", icon: "fa6-brands:node-js" },
	{ name: "Python", icon: "fa6-brands:python" },
	{ name: "Golang", icon: "fa6-brands:golang" },
];

const contactLinks = [
	{ name: "RSS", icon: "fa6-solid:rss", url: url("/rss.xml"), external: false },
	{ name: "Bilibili", icon: "fa6-brands:bilibili", url: "https://space.bilibili.com/523354432", external: true },
	{ name: "GitHub", icon: "fa6-brands:github", url: "https://github.com/YUME-0721", external: true },
	{ name: "Email", icon: "material-symbols:mail-outline-rounded", url: "mailto:contact@yumekai.top", external: true },
	{ name: "Umami 统计", icon: "material-symbols:analytics-outline-rounded", url: "https://umami.yumekai.top/share/46vKiUC2hTE5PytG", external: true },
	{ name: "画廊", icon: "material-symbols:photo-library-outline-rounded", url: "https://img.072199.xyz/browse/wallpaper", external: true },
];

const heroBg = "https://pic.yumekai.top/pic?img=ua";
---

<MainGridLayout title="首页" hideSidebar={true} isHeroHome={true}>
    <div class="flex flex-col w-full relative" id="home-root">
        <!-- 贯穿全页的唯一统一遮罩蒙版：消灭任何两层遮罩重叠造成的色差横条 -->
        <div class="absolute inset-0 pointer-events-none z-0" id="home-unified-overlay"></div>
        
        <!-- 右侧贯穿全页的垂直打字机印花列（z-30 浮在面板上方，第一条与首屏 Hero 垂直方向绝对对称） -->
        <div class="absolute right-3 sm:right-6 md:right-8 top-0 bottom-0 z-30 select-none pointer-events-none flex flex-col justify-around items-center py-28 sm:py-36 md:py-44 opacity-85">
            {Array.from({ length: 4 }).map((_, idx) => (
                <div class="flex items-center text-[10px] sm:text-xs md:text-sm text-neutral-800 dark:text-white/90 font-mono tracking-[0.18em] uppercase font-bold drop-shadow-sm dark:drop-shadow-[0_2px_10px_rgba(0,0,0,0.85)] my-8 sm:my-12" style="writing-mode: vertical-rl;">
                    <span class="hero-typewriter-text"></span>
                    <span class="inline-block w-3 sm:w-3.5 h-1.5 sm:h-2 mt-1 bg-[var(--primary)] animate-pulse shadow-[0_0_8px_var(--primary)]"></span>
                </div>
            ))}
        </div>
        
        <!-- ====================================================
             LAYER 2: Hero 内容层
             ==================================================== -->
        <div id="hero-content"
             class="relative w-full min-h-screen flex flex-col justify-between pt-20 md:pt-24 pb-16 md:pb-12 px-4 sm:px-8 md:px-16 overflow-hidden"
             style="z-index: 10;">

            <!-- 上段：中央超大艺术字标题与座右铭 -->
            <div class="relative z-10 mt-2 sm:mt-6 md:mt-10 py-2 sm:py-4 ml-2 sm:ml-8 md:ml-16 onload-animation" style="animation-delay: calc(var(--content-delay) + 50ms);">
                <h1 class="text-[2.25rem] min-[360px]:text-4xl min-[410px]:text-5xl sm:text-7xl md:text-8xl lg:text-9xl font-black tracking-tight text-neutral-800 dark:text-white font-sans drop-shadow-lg dark:drop-shadow-2xl mb-3 md:mb-4 leading-tight sm:leading-none select-none transition-colors duration-300">
                    <span class="block md:inline">放课后の</span>
                    <span class="bg-gradient-to-r from-[var(--primary)] via-pink-600 to-rose-600 dark:from-[var(--primary)] dark:via-pink-400 dark:to-rose-400 bg-clip-text text-transparent font-black ml-0 md:ml-2 drop-shadow-[0_4px_12px_rgba(255,100,150,0.3)] dark:drop-shadow-[0_4px_12px_rgba(255,100,150,0.5)]">技术部</span>
                </h1>
                
                <!-- 链接胶囊组 -->
                <div class="flex flex-wrap items-center gap-2 sm:gap-3 my-3 md:my-4">
                    {profileConfig.links.map(link => (
                        <a href={link.url} target="_blank" rel="noopener" class="px-3 py-1.5 sm:px-4 sm:py-2 bg-white/80 dark:bg-black/50 hover:bg-[var(--primary)] dark:hover:bg-[var(--primary)] active:scale-95 backdrop-blur-md rounded-xl text-xs md:text-sm font-semibold flex items-center gap-1.5 sm:gap-2 border border-black/10 dark:border-white/20 transition-all text-neutral-800 dark:text-white hover:text-white dark:hover:text-white shadow-md">
                            {link.icon && <Icon name={link.icon} class="text-sm sm:text-base text-[var(--primary)]" />}
                            <span>{link.name}: {profileConfig.name}</span>
                        </a>
                    ))}
                </div>

                <!-- 座右铭 -->
                <p class="text-xs sm:text-base md:text-2xl text-neutral-800/90 dark:text-white/90 font-medium tracking-wider max-w-3xl leading-relaxed mt-3 md:mt-4 drop-shadow-sm dark:drop-shadow-md border-l-2 border-[var(--primary)] pl-3 sm:pl-4 transition-colors duration-300">
                    出发！去互联网世界里捡星星✨
                </p>
            </div>

            <!-- 中段：饱满高质感展示大卡片（消灭大面积留白，铺满视口中间位置） -->
            <div class="relative z-10 my-auto py-2 sm:py-4 w-full max-w-4xl ml-0 sm:ml-8 md:ml-16 onload-animation" style="animation-delay: calc(var(--content-delay) + 120ms);">
                <div class="card-base p-4 sm:p-6 rounded-2xl border border-black/15 dark:border-white/20 bg-white/40 dark:bg-black/40 backdrop-blur-md shadow-2xl flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4 hover:border-[var(--primary)]/50 transition duration-300">
                    <!-- 左侧：快捷导航与探索指南 -->
                    <div class="flex flex-col gap-1.5 sm:gap-2">
                        <div class="text-[10px] sm:text-xs font-mono font-bold tracking-widest text-[var(--primary)] uppercase flex items-center gap-1.5">
                            <span class="inline-block w-2 h-2 rounded-full bg-[var(--primary)] animate-pulse"></span>
                            <span>EXPLORE / 探秘全站</span>
                        </div>
                        <h3 class="text-sm sm:text-lg font-bold text-black/90 dark:text-white/90">进入技术与灵感的拾星之旅</h3>
                        <div class="flex flex-wrap items-center gap-2 mt-1">
                            <a href={url("/archive/")} class="btn-regular px-3 py-1.5 rounded-xl text-xs font-semibold flex items-center gap-1.5 border border-black/10 dark:border-white/15 hover:border-[var(--primary)]/60 text-neutral-800 dark:text-neutral-200 hover:text-[var(--primary)] active:scale-95 transition">
                                <Icon name="material-symbols:library-books-outline-rounded" class="text-base text-[var(--primary)]" />
                                <span>文章归档</span>
                            </a>
                            <a href="https://pic.yumekai.top" target="_blank" rel="noopener" class="btn-regular px-3 py-1.5 rounded-xl text-xs font-semibold flex items-center gap-1.5 border border-black/10 dark:border-white/15 hover:border-[var(--primary)]/60 text-neutral-800 dark:text-neutral-200 hover:text-[var(--primary)] active:scale-95 transition">
                                <Icon name="material-symbols:photo-library-outline-rounded" class="text-base text-[var(--primary)]" />
                                <span>绮想絵廊</span>
                            </a>
                            <a href={url("/rss.xml")} target="_blank" class="btn-regular px-3 py-1.5 rounded-xl text-xs font-semibold flex items-center gap-1.5 border border-black/10 dark:border-white/15 hover:border-[var(--primary)]/60 text-neutral-800 dark:text-neutral-200 hover:text-[var(--primary)] active:scale-95 transition">
                                <Icon name="material-symbols:rss-feed-rounded" class="text-base text-[var(--primary)]" />
                                <span>RSS 订阅</span>
                            </a>
                        </div>
                    </div>

                    <!-- 右侧：快看三元指标 -->
                    <div class="flex items-center justify-around md:justify-end gap-3 sm:gap-6 pt-3 md:pt-0 border-t md:border-t-0 border-l-0 md:border-l border-black/10 dark:border-white/10 pl-0 md:pl-6">
                        <div class="flex flex-col items-center md:items-start">
                            <span class="text-[10px] text-neutral-500 dark:text-neutral-400 font-mono font-semibold uppercase">ARTICLES</span>
                            <span class="text-base sm:text-xl font-black text-[var(--primary)]">{allPosts.length} <span class="text-xs font-normal text-neutral-600 dark:text-neutral-400">篇</span></span>
                        </div>
                        <div class="flex flex-col items-center md:items-start">
                            <span class="text-[10px] text-neutral-500 dark:text-neutral-400 font-mono font-semibold uppercase">CATEGORIES</span>
                            <span class="text-base sm:text-xl font-black text-[var(--primary)]">{categories.length} <span class="text-xs font-normal text-neutral-600 dark:text-neutral-400">类</span></span>
                        </div>
                        <div class="flex flex-col items-center md:items-start">
                            <span class="text-[10px] text-neutral-500 dark:text-neutral-400 font-mono font-semibold uppercase">TAGS</span>
                            <span class="text-base sm:text-xl font-black text-[var(--primary)]">{tags.length} <span class="text-xs font-normal text-neutral-600 dark:text-neutral-400">个</span></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 下段：移动端居中弹跳下滑提示 -->
            <div class="relative z-10 mt-auto pt-2 pb-2">
                <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-1 opacity-70 hover:opacity-100 transition md:hidden animate-bounce select-none pointer-events-none">
                    <span class="text-[10px] font-mono tracking-widest uppercase text-neutral-600 dark:text-neutral-300">SCROLL</span>
                    <Icon name="material-symbols:keyboard-double-arrow-down-rounded" class="text-xl text-[var(--primary)]" />
                </div>
            </div>
        </div>

        <!-- ====================================================
             LAYER 3: 内容区域 — 液态玻璃上滑面板
             滑动时此区域覆盖背景图，产生"解锁"拉幕效果
             ==================================================== -->
        <div id="content-panel"
             class="relative w-full"
             style="z-index: 20;">

            <!-- 主内容面板：液态毛玻璃背景，亮暗双模式 -->
            <!-- 顶部圆角 + 过渡光晕通过 ::before 伪元素实现，无 sticky 横条 -->
            <div id="content-glass-panel"
                 class="w-full">

                <!-- 内容居中布局区 -->
                <div class="max-w-[var(--page-width)] w-full mx-auto px-3.5 sm:px-4 py-8 sm:py-12 flex flex-col gap-6 sm:gap-8">
                    
                    <!-- SECTION 2: 站点数据 & 能力矩阵 -->
                    <div class="flex flex-col gap-3.5 sm:gap-4">
                        <!-- Section Sub-header -->
                        <div class="onload-animation" style="animation-delay: calc(var(--content-delay) + 150ms);">
                            <div class="text-xs font-mono font-bold tracking-widest text-[var(--primary)] uppercase mb-1">CONTEXT</div>
                            <h2 class="text-xl sm:text-2xl md:text-3xl font-black text-black/90 dark:text-white/90">站点数据 & 能力矩阵</h2>
                        </div>

                        <!-- Grid Matrix Cards -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5 sm:gap-4">
                            <!-- Card A: 站点访问 -->
                            <div class="card-base relative overflow-hidden rounded-[var(--radius-large)] border border-black/15 dark:border-white/20 p-4 sm:p-6 flex flex-col justify-between min-h-[8.5rem] sm:min-h-[9.5rem] group shadow-lg hover:border-[var(--primary)]/60 transition duration-300 onload-animation" style="animation-delay: calc(var(--content-delay) + 200ms);">
                                <div class="absolute inset-0 bg-cover bg-center opacity-25 dark:opacity-15 group-hover:scale-105 transition-transform duration-700 pointer-events-none" style={`background-image: url('${heroBg}');`}></div>
                                <div class="relative z-10">
                                    <div class="text-xs font-mono font-bold tracking-widest text-neutral-500 dark:text-neutral-400 uppercase mb-1">VISITS</div>
                                    <h3 class="text-lg sm:text-xl md:text-2xl font-bold text-black/90 dark:text-white/90">站点访问</h3>
                                </div>
                                <div class="relative z-10 mt-3 pt-3 border-t border-black/10 dark:border-white/10 text-xs sm:text-sm md:text-base font-semibold text-neutral-600 dark:text-neutral-300">
                                    <span>访客 <strong id="matrix-site-visitors" class="text-[var(--primary)] font-bold text-base sm:text-lg">—</strong></span>
                                    <span class="mx-1 text-neutral-300 dark:text-neutral-600">/</span>
                                    <span>浏览 <strong id="matrix-site-views" class="text-[var(--primary)] font-bold text-base sm:text-lg">—</strong></span>
                                </div>
                            </div>

                            <!-- Card B: 文章档案 -->
                            <a href={url("/archive/")} class="card-base relative overflow-hidden rounded-[var(--radius-large)] border border-black/15 dark:border-white/20 p-4 sm:p-6 flex flex-col justify-between hover:border-[var(--primary)]/60 shadow-lg transition duration-300 group onload-animation" style="animation-delay: calc(var(--content-delay) + 250ms);">
                                <div class="absolute -right-10 -bottom-10 w-48 h-48 bg-[var(--primary)]/10 rounded-full blur-2xl group-hover:scale-125 transition duration-500"></div>
                                <div>
                                    <div class="text-xs font-mono font-bold tracking-widest text-neutral-500 dark:text-neutral-400 uppercase mb-1">ARCHIVE</div>
                                    <h3 class="text-lg sm:text-xl md:text-2xl font-bold text-black/90 dark:text-white/90 group-hover:text-[var(--primary)] transition">文章档案</h3>
                                </div>
                                <div class="mt-3 sm:mt-4 pt-3 sm:pt-4 border-t border-black/10 dark:border-white/10 flex items-center justify-between">
                                    <div class="text-xs sm:text-sm md:text-base font-semibold text-neutral-600 dark:text-neutral-300">
                                        <span class="text-[var(--primary)] font-bold text-base sm:text-lg">{allPosts.length}</span> 篇文章 / <span class="text-[var(--primary)] font-bold text-base sm:text-lg">{categories.length}</span> 个分类 / <span class="text-[var(--primary)] font-bold text-base sm:text-lg">{tags.length}</span> 个标签
                                    </div>
                                    <Icon name="material-symbols:chevron-right-rounded" class="text-xl sm:text-2xl text-[var(--primary)] group-hover:translate-x-1 transition" />
                                </div>
                            </a>
                        </div>

                        <!-- Card C: 社交联系 -->
                        <div class="card-base rounded-[var(--radius-large)] border border-black/15 dark:border-white/20 p-4 sm:p-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-3 sm:gap-4 overflow-hidden shadow-lg hover:border-[var(--primary)]/60 transition duration-300 onload-animation" style="animation-delay: calc(var(--content-delay) + 300ms);">
                            <div class="flex-shrink-0">
                                <div class="text-xs font-mono font-bold tracking-widest text-neutral-500 dark:text-neutral-400 uppercase mb-1">CONTACT</div>
                                <h3 class="text-lg sm:text-xl font-bold text-black/90 dark:text-white/90 mb-0.5 sm:mb-1">社交联系</h3>
                                <p class="text-[11px] sm:text-xs text-neutral-500 dark:text-neutral-400">把散落的入口收束在一条缓慢移动的轨道里。</p>
                            </div>
                            <div class="flex flex-wrap items-center gap-2 max-w-full py-0.5 sm:py-1">
                                {contactLinks.map(item => (
                                    <a href={item.url} target={item.external ? "_blank" : undefined} rel={item.external ? "noopener" : undefined} class="btn-regular px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-full text-xs font-semibold flex items-center gap-1.5 sm:gap-2 border border-black/10 dark:border-white/15 text-neutral-700 dark:text-neutral-200 hover:text-[var(--primary)] hover:border-[var(--primary)]/50 active:scale-95 transition">
                                        <Icon name={item.icon} class="text-sm sm:text-base text-[var(--primary)]" />
                                        <span>{item.name}</span>
                                    </a>
                                ))}
                            </div>
                        </div>

                        <!-- Card D: 技能图标 -->
                        <div class="card-base rounded-[var(--radius-large)] border border-black/15 dark:border-white/20 p-4 sm:p-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-3 sm:gap-4 overflow-hidden shadow-lg hover:border-[var(--primary)]/60 transition duration-300 onload-animation" style="animation-delay: calc(var(--content-delay) + 350ms);">
                            <div class="flex-shrink-0">
                                <div class="text-xs font-mono font-bold tracking-widest text-neutral-500 dark:text-neutral-400 uppercase mb-1">SKILLS</div>
                                <h3 class="text-lg sm:text-xl font-bold text-black/90 dark:text-white/90 mb-0.5 sm:mb-1">技能图标</h3>
                                <p class="text-[11px] sm:text-xs text-neutral-500 dark:text-neutral-400">工程、内容和部署工具在同一条轨道上循环。</p>
                            </div>
                            <div class="flex flex-wrap items-center gap-2 sm:gap-3 max-w-full py-0.5 sm:py-1">
                                {skillsList.map(skill => (
                                    <div class="flex items-center gap-1.5 sm:gap-2 px-2.5 py-1.5 sm:px-3 sm:py-2 rounded-xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/15 text-neutral-700 dark:text-neutral-200 text-[11px] sm:text-xs font-medium hover:scale-105 transition" title={skill.name}>
                                        <Icon name={skill.icon} class="text-base sm:text-lg text-[var(--primary)]" />
                                        <span>{skill.name}</span>
                                    </div>
                                ))}
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 3: 最新发布文章 -->
                    <div class="flex flex-col gap-4 pt-2">
                        <div class="flex items-center justify-between px-2 pt-2 pb-1 onload-animation" style="animation-delay: calc(var(--content-delay) + 400ms);">
                            <div class="flex items-center gap-2 font-bold text-lg md:text-xl text-black/90 dark:text-white/90">
                                <Icon name="material-symbols:auto-awesome-outline-rounded" class="text-2xl text-[var(--primary)]" />
                                <span>最新发布</span>
                            </div>
                            <a href={url("/posts/")} class="btn-regular px-3.5 py-1.5 rounded-lg text-xs md:text-sm font-medium text-[var(--primary)] flex items-center gap-1 hover:underline active:scale-95 transition">
                                <span>查看全部文章</span>
                                <Icon name="material-symbols:arrow-forward-rounded" class="text-base" />
                            </a>
                        </div>

                        {recentPosts.map((entry: CollectionEntry<"posts">) => (
                            <div class="onload-animation" style={`animation-delay: calc(var(--content-delay) + ${delay++ * interval + 450}ms);`}>
                                <PostCard
                                    entry={entry}
                                    title={entry.data.title}
                                    published={entry.data.published}
                                    updated={entry.data.updated}
                                    url={getPostUrlBySlug(entry.slug)}
                                    image={entry.data.image}
                                    description={entry.data.description}
                                    draft={entry.data.draft}
                                ></PostCard>
                            </div>
                        ))}

                        <div class="onload-animation text-center pt-2 pb-4" style={`animation-delay: calc(var(--content-delay) + ${delay * interval + 500}ms);`}>
                            <a href={url("/posts/")} class="btn-card inline-flex items-center gap-2 px-6 py-3 rounded-xl font-bold text-[var(--primary)] hover:bg-[var(--btn-card-bg-hover)] active:scale-95 transition shadow-sm border border-black/5 dark:border-white/10">
                                <Icon name="material-symbols:library-books-outline-rounded" class="text-xl" />
                                <span>浏览全站更多文章与分类 ({allPosts.length} 篇)</span>
                                <Icon name="material-symbols:chevron-right-rounded" class="text-xl" />
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>
</MainGridLayout>

<style>
/* =============================================
   液态玻璃滚动系统 - 全局样式
   ============================================= */

/* 内容面板 - 亮色模式（白色半透明遮罩） */
/* 贯穿全页的唯一背景遮罩蒙版 - 亮色模式（全页唯一统一透明度与颜色，包覆 Footer 绝无白色硬块） */
#home-unified-overlay {
    bottom: -300px;
    background: rgba(245, 245, 250, 0.52);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    transition: background 0.4s ease;
}

/* 贯穿全页的唯一背景遮罩蒙版 - 暗色模式 */
:global(.dark) #home-unified-overlay {
    background: rgba(12, 12, 18, 0.58);
    backdrop-filter: blur(20px) saturate(150%);
    -webkit-backdrop-filter: blur(20px) saturate(150%);
}
</style>

<script define:vars={{ umamiConfig }}>
(function() {
    // ============================================
    // 1. 液态玻璃滚动效果
    // ============================================
    const heroContent = document.getElementById('hero-content');

    let ticking = false;

    function updateScrollEffect() {
        const scrollY = window.scrollY;
        const heroHeight = heroContent ? heroContent.offsetHeight : window.innerHeight;
        
        // ── 内容区域毛玻璃切换 ──
        const transitionStart = heroHeight * 0.70;
        const transitionEnd = heroHeight * 1.05;
        const progress = Math.max(0, Math.min(1, (scrollY - transitionStart) / (transitionEnd - transitionStart)));

        const contentPanel = document.getElementById('content-panel');
        if (contentPanel) {
            if (progress > 0.05) {
                contentPanel.classList.add('is-scrolled');
                document.body.classList.add('has-scrolled-hero');
            } else {
                contentPanel.classList.remove('is-scrolled');
                document.body.classList.remove('has-scrolled-hero');
            }
        }

        // ── Hero 文字随滚动轻微淡出（视差层次感）──
        if (heroContent) {
            const fadeProgress = Math.min(1, scrollY / (heroHeight * 0.6));
            heroContent.style.opacity = String(1 - fadeProgress * 0.35);
        }

        ticking = false;
    }

    window.addEventListener('scroll', function() {
        if (!ticking) {
            requestAnimationFrame(updateScrollEffect);
            ticking = true;
        }
    }, { passive: true });

    // 初始执行一次
    updateScrollEffect();

    // ============================================
    // 2. Umami 站点统计数据
    // ============================================
    function formatCount(num) {
        if (num >= 1000) {
            return (num / 1000).toFixed(1).replace(/\.0$/, '') + 'k';
        }
        return num.toString();
    }

    async function loadMatrixSiteStats() {
        if (!umamiConfig.enabled || typeof window.getUmamiPageStats !== 'function') return;
        try {
            const statsData = await window.getUmamiPageStats(
                umamiConfig.baseUrl,
                umamiConfig.websiteId,
                null,
                umamiConfig.shareId
            );
            const pageviews = statsData.pageviews || 0;
            const visitors = statsData.visitors || 0;
            const viewsEl = document.getElementById('matrix-site-views');
            const visitorsEl = document.getElementById('matrix-site-visitors');
            if (viewsEl) viewsEl.textContent = formatCount(pageviews);
            if (visitorsEl) visitorsEl.textContent = formatCount(visitors);
        } catch (e) {
            console.error('Failed to load matrix site stats', e);
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', loadMatrixSiteStats);
    } else {
        loadMatrixSiteStats();
    }
    document.addEventListener('content:replace', loadMatrixSiteStats);

    // ============================================
    // 3. 打字机效果（多标语同步从上到下逐字打出）
    // ============================================
    function initTypewriter() {
        const typewriterEls = document.querySelectorAll('.hero-typewriter-text');
        if (!typewriterEls || !typewriterEls.length) return;
        const text = "WELCOME TO MY BLOG, ENJOY YOUR STAY!";
        let idx = 0;
        typewriterEls.forEach(el => { el.textContent = ''; });
        
        function typeChar() {
            if (idx < text.length) {
                idx++;
                const currentText = text.substring(0, idx);
                typewriterEls.forEach(el => {
                    el.textContent = currentText;
                });
                setTimeout(typeChar, 70);
            }
        }
        setTimeout(typeChar, 400);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initTypewriter);
    } else {
        initTypewriter();
    }
})();
</script>
