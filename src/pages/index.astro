---
import type { CollectionEntry } from "astro:content";
import Pagination from "../components/control/Pagination.astro";
import PostPage from "../components/PostPage.astro";
import { PAGE_SIZE } from "../constants/constants";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../utils/content-utils";
import { url } from "../utils/url-utils";
import { siteConfig } from "../config";

const allPosts = await getSortedPosts();
const postsCount = allPosts.length;
const totalPages = Math.ceil(postsCount / PAGE_SIZE);
const pagePosts = allPosts.slice(0, PAGE_SIZE);

const formattedPage = {
	data: pagePosts,
	start: 0,
	end: pagePosts.length - 1,
	size: PAGE_SIZE,
	total: postsCount,
	currentPage: 1,
	lastPage: totalPages,
	url: {
		current: url("/"),
		prev: undefined,
		next: totalPages > 1 ? url("/posts/2/") : undefined,
	},
};

const len = formattedPage.data.length;
---

<MainGridLayout title="首页">
    <!-- ====================================================
         HERO WELCOME HEADER（全宽居中浮空展示）
         ==================================================== -->
    <div slot="top" class="w-full pt-6 pb-8 sm:pt-8 sm:pb-10 md:pt-10 md:pb-14 px-4 select-none onload-animation">
        <div class="flex flex-col items-center text-center mx-auto gap-3 max-w-4xl">
            <!-- 顶部微型标签 -->
            <div class="flex items-center justify-center gap-2">
                <span class="inline-block w-2 h-2 rounded-full bg-[var(--primary)] animate-ping"></span>
                <span class="text-xs sm:text-sm font-mono font-bold tracking-[0.22em] uppercase text-[var(--primary)] drop-shadow-[0_2px_4px_rgba(0,0,0,0.85)]">
                    WELCOME / 放课后の技术部
                </span>
            </div>

            <!-- 主标题 -->
            <div>
                <h1 class="text-4xl sm:text-5xl md:text-6xl font-black tracking-tight text-neutral-900 dark:text-white drop-shadow-[0_4px_12px_rgba(0,0,0,0.9)] flex items-center justify-center gap-3">
                    <span>{siteConfig.title}</span>
                    <span class="text-3xl sm:text-4xl md:text-5xl inline-block animate-bounce">✨</span>
                </h1>
            </div>

            <!-- 宣传语 / 站点描述 -->
            <p class="text-sm sm:text-base md:text-lg text-neutral-800 dark:text-neutral-200 font-medium leading-relaxed max-w-2xl drop-shadow-[0_2px_8px_rgba(0,0,0,0.85)] mx-auto">
                出发！去互联网世界里捡星星～ 记录网络架构、服务器运维、Docker 与全栈开发的探索之旅。
            </p>
        </div>
    </div>

    <!-- ====================================================
         LATEST POSTS LIST（三栏下方正文内容流）
         ==================================================== -->
    <PostPage page={formattedPage}></PostPage>
    <Pagination
        class="mx-auto onload-animation"
        page={formattedPage}
        style={`animation-delay: calc(var(--content-delay) + ${len * 50}ms)`}
    ></Pagination>
</MainGridLayout>
