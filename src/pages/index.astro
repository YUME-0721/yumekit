---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import HomeStatsMatrix from "../components/home/HomeStatsMatrix.astro";
import TerminalPlayground from "../components/home/TerminalPlayground.svelte";
import PostCard from "../components/PostCard.astro";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../utils/content-utils";
import { getPostUrlBySlug, url } from "../utils/url-utils";
import { siteConfig } from "../config";

const allPosts = await getSortedPosts();
const postsCount = allPosts.length;
// 首页精选展示最新发布的 3 篇文章
const latestPosts = allPosts.slice(0, 3);

let delay = 0;
const interval = 50;
---

<MainGridLayout title="首页">
    <!-- ====================================================
         HERO WELCOME HEADER（全宽居中浮空展示）
         ==================================================== -->
    <div slot="top" class="w-full pt-6 pb-8 sm:pt-8 sm:pb-10 md:pt-10 md:pb-14 px-4 select-none onload-animation">
        <div class="flex flex-col items-center text-center mx-auto gap-3 max-w-4xl">
            <!-- 顶部微型标签 -->
            <div class="flex items-center justify-center gap-2">
                <span class="inline-block w-2 h-2 rounded-full bg-[var(--primary)] animate-ping"></span>
                <span class="text-xs sm:text-sm font-mono font-bold tracking-[0.22em] uppercase text-[var(--primary)] drop-shadow-[0_2px_4px_rgba(0,0,0,0.85)]">
                    WELCOME / 放课后の技术部
                </span>
            </div>

            <!-- 主标题 -->
            <div>
                <h1 class="text-4xl sm:text-5xl md:text-6xl font-black tracking-tight text-neutral-900 dark:text-white drop-shadow-[0_4px_12px_rgba(0,0,0,0.9)] flex items-center justify-center gap-3">
                    <span>{siteConfig.title}</span>
                    <span class="text-3xl sm:text-4xl md:text-5xl inline-block animate-bounce">✨</span>
                </h1>
            </div>

            <!-- 宣传语 / 站点描述 -->
            <p class="text-sm sm:text-base md:text-lg text-neutral-800 dark:text-neutral-200 font-medium leading-relaxed max-w-2xl drop-shadow-[0_2px_8px_rgba(0,0,0,0.85)] mx-auto">
                出发！去互联网世界里捡星星～
                <br />
                记录网络架构、服务器运维、Docker 与全栈开发的探索之旅。
            </p>
        </div>
    </div>

    <!-- ====================================================
         极客终端沙盒 · CLI PLAYGROUND
         ==================================================== -->
    <div class="onload-animation mb-8 flex flex-col gap-2.5">
        <div class="flex items-center justify-between px-1">
            <div class="flex items-center gap-2">
                <span class="text-xl">💻</span>
                <h2 class="text-xl sm:text-2xl font-black text-neutral-900 dark:text-neutral-100 tracking-tight">
                    极客终端沙盒
                </h2>
            </div>
            <span class="text-[11px] font-mono font-semibold tracking-wider text-[var(--primary)] uppercase bg-[var(--primary)]/10 px-2.5 py-1 rounded-full border border-[var(--primary)]/20 shadow-sm">
                INTERACTIVE CLI
            </span>
        </div>
        <TerminalPlayground client:only="svelte" />
    </div>

    <!-- ====================================================
         站点数据 & 能力矩阵（复合信息与状态大屏）
         ==================================================== -->
    <div class="onload-animation mb-8">
        <HomeStatsMatrix />
    </div>

    <!-- ====================================================
         LATEST 3 POSTS（最新发布前三篇文章 + 查看更多）
         ==================================================== -->
    <div class="flex flex-col gap-4 w-full">
        <!-- 模块标题栏 -->
        <div class="flex items-center justify-between px-1 onload-animation">
            <div class="flex items-center gap-2">
                <span class="text-xl">✨</span>
                <h2 class="text-xl sm:text-2xl font-black text-neutral-900 dark:text-neutral-100 tracking-tight">
                    最新发布
                </h2>
            </div>

            <a
                href={url("/posts/")}
                class="px-3.5 py-1.5 rounded-full bg-black/5 dark:bg-white/5 hover:bg-[var(--primary)] hover:text-white dark:hover:bg-[var(--primary)] dark:hover:text-white text-xs font-bold text-neutral-700 dark:text-neutral-300 transition-all flex items-center gap-1.5 border border-black/5 dark:border-white/5 shadow-sm active:scale-95 group"
            >
                <span>查看全部文章</span>
                <Icon name="material-symbols:arrow-forward-rounded" class="text-sm group-hover:translate-x-0.5 transition-transform" />
            </a>
        </div>

        <!-- 文章列表流（前三篇） -->
        <div class="flex flex-col gap-4">
            {latestPosts.map((entry: CollectionEntry<"posts">) => (
                <div class="onload-animation" style={`animation-delay: calc(var(--content-delay) + ${delay++ * interval}ms);`}>
                    <PostCard
                        entry={entry}
                        title={entry.data.title}
                        published={entry.data.published}
                        updated={entry.data.updated}
                        url={getPostUrlBySlug(entry.slug)}
                        image={entry.data.image}
                        description={entry.data.description}
                        draft={entry.data.draft}
                    />
                </div>
            ))}
        </div>

        <!-- 底部查看更多大按钮 -->
        <a
            href={url("/posts/")}
            class="card-base p-4 text-center font-bold text-sm text-neutral-600 dark:text-neutral-300 hover:text-[var(--primary)] dark:hover:text-[var(--primary)] hover:border-[var(--primary)]/40 transition-all duration-300 flex items-center justify-center gap-2 group onload-animation"
            style={`animation-delay: calc(var(--content-delay) + ${latestPosts.length * interval}ms);`}
        >
            <span>展开查看更多文章（共 {postsCount} 篇）</span>
            <Icon name="material-symbols:arrow-forward-rounded" class="text-base group-hover:translate-x-1 transition-transform" />
        </a>
    </div>
</MainGridLayout>
